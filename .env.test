# Test environment configuration
# Used by vitest for database schema names in test containers

# Placeholder values — NOT used at runtime.
# Testcontainers overrides these in tests; knip only needs config parsing to succeed.
# They exist solely to satisfy module-level .parse(env) side effects during import.
EVENTSTORE_DB_HOST=placeholder
EVENTSTORE_DB_NAME=placeholder
EVENTSTORE_DB_PASSWORD=placeholder
EVENTSTORE_DB_PORT=5432
EVENTSTORE_DB_USE_SSL=false
EVENTSTORE_DB_USER=placeholder

READMODEL_DB_HOST=placeholder
READMODEL_DB_NAME=placeholder
READMODEL_DB_PASSWORD=placeholder
READMODEL_DB_PORT=5432
READMODEL_DB_USE_SSL=false
READMODEL_DB_USER=placeholder

REMOTE_RESOURCE_DB_HOST=placeholder
REMOTE_RESOURCE_DB_NAME=placeholder
REMOTE_RESOURCE_DB_PASSWORD=placeholder
REMOTE_RESOURCE_DB_PORT=5432
REMOTE_RESOURCE_DB_USE_SSL=false
REMOTE_RESOURCE_DB_USER=placeholder

SIGNAL_HUB_DB_HOST=placeholder
SIGNAL_HUB_DB_NAME=signal_hub
SIGNAL_HUB_DB_PASSWORD=placeholder
SIGNAL_HUB_DB_PORT=5432
SIGNAL_HUB_DB_USE_SSL=false
SIGNAL_HUB_DB_USER=placeholder

