meta {
  name: Create Eservice (minimal)
  type: http
  seq: 5
}

post {
  url: {{host-eservice-process}}/eservices
  body: json
}

headers {
  X-Correlation-Id: {{correlation-id}}
}

body:json {
  {
    "name": {
      "en": "{{randomName}}"
    },
    "description": {
      "en": "Minimal e-service with only required fields"
    },
    "accessTokenAudience": ["https://api.example.com"],
    "maxDailyCallsPerConsumer": 1000,
    "maxDailyCallsPerKnode": 10000,
    "requiredAttributes": [],
    "interfaceDocument": {
      "checksum": "checksum-1",
      "contentType": "application/x-yaml",
      "id": "c5f2d4c3-9d3e-4f18-9b78-6c33d4a8e4f1",
      "name": "openapi.yaml",
      "path": "/interfaces/openapi.yaml",
      "prettyName": {
        "en": "Test Interface"
      }
    }
  }
}

vars:post-response {
  eserviceId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomName", `Minimal Eservice ${random}`)
}
