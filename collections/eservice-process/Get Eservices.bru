meta {
  name: Get Eservices
  type: http
  seq: 1
}

get {
  url: {{host-eservice-process}}/eservices?offset=0&limit=50
  body: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
}

params:query {
  offset: 0
  limit: 50
  ~q:
  ~status: Active
  ~mode: ProvideData
  ~producerId:
  ~sortBy: name
  ~sortOrder: asc
}

vars:post-response {
  eserviceId: res.body.items[0].id
}
