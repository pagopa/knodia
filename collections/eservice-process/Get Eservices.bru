meta {
  name: Get Eservices
  type: http
}

get {
  url: {{host-eservice-process}}/eservices?offset=0&limit=50
  body: none
  auth: none
}

params:query {
  offset: 0
  limit: 50
  ~q:
  ~state: Active
  ~mode: ProvideData
  ~producerId:
  ~sortBy: name
  ~sortOrder: asc
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

vars:post-response {
  eserviceId: res.body.items[0].id
}
