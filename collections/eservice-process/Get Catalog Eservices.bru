meta {
  name: Get Catalog Eservices
  type: http
}

post {
  url: {{host-eservice-process}}/catalog?offset=0&limit=50
  body: json
}

params:query {
  limit: 50
  offset: 0
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}

body:json {
  {
    "keywords": "test"
  }
}
