meta {
  name: Update Eservice
  type: http
}

patch {
  url: {{host-eservice-process}}/eservices/:eserviceId
  body: json
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

headers {
  Content-Type: application/merge-patch+json
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{updatedEserviceName}}"
    },
    "description": {
      "en": "Updated description"
    },
    "categories": [
      {
        "code": "citizen.identity.birth_date",
        "scheme": "vc_example_eservice_categories"
      }
    ]
  }
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("updatedEserviceName", bru.getEnvVar("fixedName") || `Updated name ${random}`)
}
