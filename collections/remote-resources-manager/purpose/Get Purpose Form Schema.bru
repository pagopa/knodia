meta {
  name: Get Purpose Form Schema
  type: http
}

get {
  url: {{host-remote-resources-manager}}/purposes/formSchemas/:purposeSchemaVersion?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
}

params:path {
  purposeSchemaVersion: 1.0
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}
