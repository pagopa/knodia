meta {
  name: Get Purpose Form UI Schema
  type: http
}

get {
  url: {{host-remote-resources-manager}}/purposes/formSchemas/:purposeSchemaVersion/ui
  body: none
  auth: none
}

params:path {
  purposeSchemaVersion: 1.0
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}
