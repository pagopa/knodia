meta {
  name: Get Purpose Form UI Schema
  type: http
}

get {
  url: {{host-remote-resources-manager}}/purposes/formSchemas/current/ui?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}

vars:post-response {
  purposeFormSchemaVersion.body.version
}
