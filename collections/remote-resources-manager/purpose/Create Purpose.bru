meta {
  name: Create Purpose
  type: http
}

post {
  url: {{host-remote-resources-manager}}/purposes
  body: json
  auth: none
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "Test Purpose"
    },
    "description": {
      "en": "A test purpose for accessing data"
    },
    "eserviceId": "{{eserviceId}}",
    "knodeId": "{{other-knode-id}}",
    "dailyCalls": 100,
    "formAnswersJson": {
      "confirmPrincipleIntegrityAndDiscretion": "true",
      "declarationConfirmGDPR": "true",
      "legalBasis": ["CONSENT"],
      "personalDataTypes": ["WITH_IDENTIFYING_DATA"],
      "purpose": "INSTITUTIONAL",
      "purposeDescription": "Test purpose",
      "purposePursuit": "MERE_CORRECTNESS",
      "usesThirdPartyPersonalData": "NO"
    },
    "formSchemaVersion": "1.0"
  }
}

vars:post-response {
  purposeId: res.body.id
}
