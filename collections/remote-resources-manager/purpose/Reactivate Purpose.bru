meta {
  name: Reactivate Purpose
  type: http
}

post {
  url: {{host-remote-resources-manager}}/purposes/:purposeId/reactivate?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}
