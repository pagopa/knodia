meta {
  name: Get Eservice PurposeFormOptions
  type: http
}

get {
  url: {{host-remote-resources-manager}}/eservices/{{eserviceId}}/purposeFormOptions?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}
