meta {
  name: Get Eservice Details
  type: http
}

get {
  url: {{host-remote-resources-manager}}/eservices/:eserviceId?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}
