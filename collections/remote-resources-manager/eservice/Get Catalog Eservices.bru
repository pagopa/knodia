meta {
  name: Get Catalog Eservices
  type: http
}

post {
  url: {{host-remote-resources-manager}}/catalog?offset=0&limit=50
  body: json
  auth: none
}

params:query {
  offset: 0
  limit: 50
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "knodeId": "{{other-knode-id}}",
    "keywords": "test"
  }
}

vars:post-response {
  total: res.body.pagination.total
  eservices: res.body.results
}
