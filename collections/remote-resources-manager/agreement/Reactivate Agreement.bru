meta {
  name: Reactivate Agreement
  type: http
}

post {
  url: {{host-remote-resources-manager}}/agreements/:agreementId/reactivation?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}
