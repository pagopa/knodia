meta {
  name: Create Agreement Activation Magic Link
  type: http
}

post {
  url: {{host-remote-resources-manager}}/agreements/:agreementId/activationMagicLink?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}
