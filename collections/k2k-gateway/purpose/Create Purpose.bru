meta {
  name: Create Purpose
  type: http
}

post {
  url: {{host-k2k-gateway}}/purposes
  body: json
}

headers {
  ~Authorization:
}

body:json {
  {
    "consumerId": "{{organizationId}}",
    "eserviceId": "{{eserviceId}}",
    "dailyCalls": 1000,
    "name": {
      "en": "Test Purpose"
    },
    "description": {
      "en": "A test purpose for accessing the e-service"
    },
    "formAnswersJson": {}
  }
}

vars:post-response {
  purposeId: res.body.id
}
