meta {
  name: Create Purpose
  type: http
}

post {
  url: {{host-k2k-gateway}}/purposes
  body: json
  auth: none
}

headers {
  ~Authorization:
}

body:json {
  {
    "consumerId": "{{organizationId}}",
    "eserviceId": "{{eserviceId}}",
    "dailyCalls": 1000,
    "name": {
      "en": "Test Purpose"
    },
    "description": {
      "en": "A test purpose for accessing the e-service"
    },
    "formAnswersJson": {
      "purpose": "INSTITUTIONAL",
      "purposeDescription": "Test purpose",
      "personalDataTypes": ["WITH_IDENTIFYING_DATA"],
      "legalBasis": ["CONSENT"],
      "usesThirdPartyPersonalData": "NO"
    },
    "formSchemaVersion": "1.0"
  }
}

vars:post-response {
  purposeId: res.body.id
}
