meta {
  name: Get Consumer Keychain Client Assertion Verification Data
  type: http
}

post {
  url: {{host-k2k-gateway}}/consumerClientAssertionVerificationData
  body: json
}

body:json {
  {
    "keychainId": "{{consumerKeychainId}}",
    "kid": "{{kid}}",
    "purposeId": "{{purposeId}}"
  }
}
