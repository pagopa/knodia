meta {
  name: Get Agreements
  type: http
}

get {
  url: {{host-k2k-gateway}}/agreements?limit=50&offset=0
  body: none
  auth: none
}

params:query {
  limit: 50
  offset: 0
  ~consumerId: {{organizationId}}
  ~state: ACTIVE
}

headers {
  ~Authorization:
}

vars:post-response {
  total: res.body.pagination.total
  agreements: res.body.results
}
