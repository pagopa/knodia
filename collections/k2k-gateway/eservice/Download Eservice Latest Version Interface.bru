meta {
  name: Download Eservice Latest Version Interface
  type: http
}

get {
  url: {{host-k2k-gateway}}/eservices/:eserviceId/versions/latest/interface/download
  body: none
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}
