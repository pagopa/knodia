meta {
  name: Get Catalog Eservices
  type: http
}

post {
  url: {{host-k2k-gateway}}/catalog?offset=0&limit=50
  body: json
  auth: none
}

body:json {
  {
    "keywords": "test"
  }
}

params:query {
  offset: 0
  limit: 50
}

vars:post-response {
  total: res.body.pagination.total
  eservices: res.body.results
}
