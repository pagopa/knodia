meta {
  name: Send Digital Contact
  type: http
}

post {
  url: {{host-mock-eservice}}/digital-contacts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  {
    "contactPoint": {
      "hasEmail": "info@tutto-klima.example",
      "hasTelephone": "+39 02 1234567"
    },
    "legalEntity": {
      "legalEntityActivity": "43.22.07",
      "legalIdentifier": {
        "notation": "01229430085",
        "schemeName": "Partita Iva",
        "schemeURI": "http://memberstate.ms/VAT"
      },
      "legalName": "TUTTO - KLIMA SRL",
      "registrationDate": "2012-07-09"
    }
  }
}

script:pre-request {
  if (!bru.getVar("access_token") && !bru.getEnvVar("access_token")) {
    throw new Error(
      "access_token is not set. Run authorization-server/Create E-service Access Token first — it populates the access_token var on success."
    )
  }
}
