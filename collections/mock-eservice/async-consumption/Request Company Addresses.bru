meta {
  name: Request Company Addresses
  type: http
}

post {
  url: {{host-mock-eservice}}/legal-entities/address-requests
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

body:json {
  [
    "01229430085",
    "12345678901",
    "98765432109"
  ]
}

script:pre-request {
  if (!bru.getVar("access_token") && !bru.getEnvVar("access_token")) {
    throw new Error(
      "access_token is not set. Run authorization-server/Create E-service Access Token first — it populates the access_token var on success."
    )
  }
}

vars:post-response {
  companyAddressesRequestId: res.body.requestId
}
