meta {
  name: Get Async Company Addresses Request State
  type: http
}

get {
  url: {{host-mock-eservice}}/legal-entities/address-requests/:companyAddressesRequestId
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

params:path {
  companyAddressesRequestId: {{companyAddressesRequestId}}
}

script:pre-request {
  if (!bru.getVar("access_token")) {
    throw new Error(
      "access_token is not set. Run authorization-server/Create E-service Access Token first — it populates the access_token var on success."
    )
  }
}
