meta {
  name: Lookup ERDS
  type: http
}

get {
  url: {{host-mock-eservice}}/erds?identifier=01229430085
  body: none
  auth: none
}

params:query {
  identifier: 01229430085
}

headers {
  Authorization: Bearer {{access_token}}
}

script:pre-request {
  if (!bru.getVar("access_token") && !bru.getEnvVar("access_token")) {
    throw new Error(
      "access_token is not set. Run authorization-server/Create E-service Access Token first — it populates the access_token var on success."
    )
  }
}
