meta {
  name: Get Purpose Template Details
  type: http
}

get {
  url: {{host-backend-for-frontend}}/purposeTemplates/:purposeTemplateId?knodeId=Lynx
  body: none
}

params:path {
  purposeTemplateId: {{purposeTemplateId}}
}

params:query {
  knodeId: {{knodeId}}
}

headers {
  Authorization: {{ui-session-jwt}}
}
