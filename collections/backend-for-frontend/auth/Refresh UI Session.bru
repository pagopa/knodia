meta {
  name: Refresh UI Session
  type: http
}

post {
  url: {{host-backend-for-frontend}}/auth/ui-session/refresh
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Origin: {{authCookieAllowedOrigin}}
}

vars:post-response {
  uiSessionToken: res.body.uiSessionToken
}
