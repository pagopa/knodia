meta {
  name: Login UI Session
  type: http
}

post {
  url: {{host-backend-for-frontend}}/auth/ui-session
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Origin: {{authCookieAllowedOrigin}}
}

body:json {
  {
    "oidcToken": "{{oidcToken}}"
  }
}

vars:post-response {
  uiSessionToken: res.body.uiSessionToken
}
