meta {
  name: Get Producer Agreements
  type: http
}

get {
  url: {{host-backend-for-frontend}}/producer/agreements?limit=50&offset=0
  body: none
}

params:query {
  limit: 50
  offset: 0
  ~consumerId: {{consumerId}}
  ~consumerKnodeId: Orion
  ~eserviceId: {{eserviceId}}
  ~sortBy: eserviceName
  ~sortOrder: asc
  ~state: Active
}

headers {
  Authorization: {{ui-session-jwt}}
}
