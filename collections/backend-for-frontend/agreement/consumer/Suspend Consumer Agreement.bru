meta {
  name: Suspend Consumer Agreement
  type: http
}

post {
  url: {{host-backend-for-frontend}}/consumer/agreements/:agreementId/suspend?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  Authorization: {{ui-session-jwt}}
}

