meta {
  name: Reactivate Consumer Agreement
  type: http
}

post {
  url: {{host-backend-for-frontend}}/consumer/agreements/:agreementId/reactivate?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  Authorization: {{ui-session-jwt}}
}

vars:pre-request {
  agreementId: b22a723e-31f7-4b46-adc8-20b83007eb8d
}
