meta {
  name: Download Eservice Interface
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumer/eservices/:eserviceId/interface?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  Authorization: {{ui-session-jwt}}
}
