meta {
  name: Get Catalog Eservice Detail
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumer/eservices/:eserviceId?knodeId=Lynx
  body: none
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

params:query {
  knodeId: Lynx
}

headers {
  Authorization: {{ui-session-jwt}}
}
