meta {
  name: Get Consumer Eservice PurposeFormOptions
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumer/eservices/{{eserviceId}}/purposeFormOptions?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  Authorization: {{ui-session-jwt}}
}
