meta {
  name: Create Eservice
  type: http
  seq: 2
}

post {
  url: {{host-backend-for-frontend}}/eservices
  body: json
}

body:json {
  {
    "name": {
      "en": "{{randomName}}"
    },
    "description": {
      "en": "This is a test e-service"
    },
    "accessTokenAudience": ["https://api.example.com"],
    "accessTokenDuration": 3600,
    "accessTokenType": "Bearer",
    "maxDailyCallsPerConsumer": 1000,
    "maxDailyCallsPerKnode": 10000,
    "requiredAttributes": [
      [
        {
          "code": "test-attribute",
          "scheme": "test-scheme"
        }
      ]
    ],
    "mode": "ProvideData",
    "categories": [
      {
        "code": "test-category",
        "scheme": "test-scheme"
      }
    ],
    "isConsumerOperatorIdentificationRequired": false,
    "isSignalHubEnabled": false
  }
}

vars:post-response {
  eserviceId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomName", `Test Eservice ${random}`)
}
