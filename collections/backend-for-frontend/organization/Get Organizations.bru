meta {
  name: Get Organizations
  type: http
}

get {
  url: {{host-backend-for-frontend}}/organizations?knodeId={{other-knode-id}}&limit=50&offset=0
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
  limit: 50
  offset: 0
  ~name: Vega
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

vars:post-response {
  total: res.body.pagination.total
  organizations: res.body.results
}
