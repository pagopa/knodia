meta {
  name: Get Purpose Form Schemas
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumer/purposes/formSchemas/current?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  Authorization: {{ui-session-jwt}}
}

vars:post-response {
  purposeFormSchemasVersion: res.body.version
}
