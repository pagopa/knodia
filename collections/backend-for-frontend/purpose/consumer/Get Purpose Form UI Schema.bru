meta {
  name: Get Purpose Form UI Schema
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumer/purposes/formSchemas/current/ui?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  Authorization: {{ui-session-jwt}}
}

vars:post-response {
  purposeFormSchemaVersion: res.body.version
}
