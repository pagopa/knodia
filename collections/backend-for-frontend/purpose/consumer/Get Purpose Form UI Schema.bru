meta {
  name: Get Purpose Form UI Schema
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumer/purposes/formSchemas/:purposeSchemaVersion/ui?knodeId=Orion
  body: none
  auth: none
}

params:query {
  knodeId: Orion
}

params:path {
  purposeSchemaVersion: 1.0
}

headers {
  Authorization: {{ui-session-jwt}}
}
