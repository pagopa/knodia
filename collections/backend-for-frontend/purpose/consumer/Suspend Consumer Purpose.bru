meta {
  name: Suspend Consumer Purpose
  type: http
}

post {
  url: {{host-backend-for-frontend}}/consumer/purposes/:purposeId/suspend?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

params:query {
  knodeId: {{other-knode-id}}
}

headers {
  Authorization: {{ui-session-jwt}}
}

