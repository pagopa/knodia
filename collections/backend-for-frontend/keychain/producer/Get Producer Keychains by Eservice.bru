meta {
  name: Get Producer Keychains by Eservice
  type: http
}

get {
  url: {{host-backend-for-frontend}}/producerKeychains?offset=0&limit=50&eserviceId={{eserviceId}}
  body: none
  auth: none
}

params:query {
  offset: 0
  limit: 50
  eserviceId: {{eserviceId}}
}

headers {
  Authorization: {{ui-session-jwt}}
}
