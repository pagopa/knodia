meta {
  name: Get Producer Keychain Keys
  type: http
}

get {
  url: {{host-backend-for-frontend}}/producerKeychains/:producerKeychainId/keys?offset=0&limit=50
  body: none
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
}

params:query {
  offset: 0
  limit: 50
}

headers {
  Authorization: {{ui-session-jwt}}
}
