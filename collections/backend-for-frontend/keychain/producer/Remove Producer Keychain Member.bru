meta {
  name: Remove Producer Keychain Member
  type: http
}

delete {
  url: {{host-backend-for-frontend}}/producerKeychains/:producerKeychainId/members/:userId
  body: none
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
  userId: {{userId}}
}

headers {
  Authorization: {{ui-session-jwt}}
}
