meta {
  name: Create Consumer Keychain
  type: http
}

post {
  url: {{host-backend-for-frontend}}/consumerKeychains
  body: json
  auth: none
}

headers {
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{randomName}}"
    },
    "description": {
      "en": "This is a test consumer keychain"
    }
  }
}

vars:post-response {
  consumerKeychainId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomName", `Test Consumer Keychain ${random}`)
}
