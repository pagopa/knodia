meta {
  name: Get Consumer Keychain Members
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumerKeychains/:consumerKeychainId/members?offset=0&limit=50
  body: none
  auth: none
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
}

params:query {
  offset: 0
  limit: 50
}

headers {
  Authorization: {{ui-session-jwt}}
}
