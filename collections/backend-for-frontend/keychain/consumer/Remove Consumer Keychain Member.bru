meta {
  name: Remove Consumer Keychain Member
  type: http
}

delete {
  url: {{host-backend-for-frontend}}/consumerKeychains/:consumerKeychainId/members/:userId
  body: none
  auth: none
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
  userId: {{userId}}
}

headers {
  Authorization: {{ui-session-jwt}}
}
