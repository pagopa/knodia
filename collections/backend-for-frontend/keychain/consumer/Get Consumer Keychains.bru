meta {
  name: Get Consumer Keychains
  type: http
}

get {
  url: {{host-backend-for-frontend}}/consumerKeychains?offset=0&limit=50
  body: none
}

params:query {
  offset: 0
  limit: 50
  ~purpose: {{other-knode-id}}:{{purposeId}}
  ~eserviceId: {{eserviceId}}
}

headers {
  Authorization: {{ui-session-jwt}}
}
