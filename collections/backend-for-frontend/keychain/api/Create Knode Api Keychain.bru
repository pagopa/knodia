meta {
  name: Create Knode Api Keychain
  type: http
}

post {
  url: {{host-backend-for-frontend}}/knodeApiKeychains
  body: json
  auth: none
}

headers {
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{randomName}}"
    },
    "description": {
      "en": "This is a test knode api keychain"
    }
  }
}

vars:post-response {
  knodeApiKeychainId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomName", `Test Knode Api Keychain ${random}`)
}
