meta {
  name: Get Knode Api Keychain Members
  type: http
}

get {
  url: {{host-backend-for-frontend}}/knodeApiKeychains/:knodeApiKeychainId/members?offset=0&limit=50
  body: none
  auth: none
}

params:path {
  knodeApiKeychainId: {{knodeApiKeychainId}}
}

params:query {
  offset: 0
  limit: 50
}

headers {
  Authorization: {{ui-session-jwt}}
}
