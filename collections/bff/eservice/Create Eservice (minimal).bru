meta {
  name: Create Eservice (minimal)
  type: http
  seq: 3
}

post {
  url: {{host-bff}}/eservices
  body: json
}

body:json {
  {
    "name": {
      "en": "{{randomName}}"
    },
    "description": {
      "en": "Minimal e-service with only required fields"
    },
    "accessTokenAudience": ["https://api.example.com"],
    "maxDailyCallsPerConsumer": 1000,
    "maxDailyCallsPerKnode": 10000,
    "requiredAttributes": [],
    "interfaceDocument": {
      "checksum": "+71LiSCxtYGCJWBg0pGHY/ki3Qn3oidBGNjJkN3PCAA=",
      "content": "b3BlbmFwaTogIjMuMC4wIgppbmZvOgogIHRpdGxlOiBUZXN0CiAgdmVyc2lvbjogIjEuMCIKcGF0aHM6IHt9Cg==",
      "contentType": "application/x-yaml",
      "name": "openapi.yaml",
      "prettyName": {
        "en": "Test Interface"
      }
    }
  }
}

vars:post-response {
  eserviceId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomName", `Minimal Eservice ${random}`)
}
