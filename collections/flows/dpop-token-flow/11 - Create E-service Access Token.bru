meta {
  name: 11 - Create E-service Access Token
  type: http
  seq: 11
}

post {
  url: {{host-authorization-server}}/token
  body: formUrlEncoded
  auth: none
}

headers {
  DPoP: {{process.env.DPOP_PROOF_JWT}}
}

body:form-urlencoded {
  client_assertion: {{process.env.CLIENT_ASSERTION_JWT}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_id: {{consumerKeychainId}}
  grant_type: client_credentials
}

assert {
  res.status: eq 200
  res.body.token_type: eq DPoP
}

vars:post-response {
  access_token: res.body.access_token
}

script:post-response {
  if (res.status === 200) return
  
  const rsaKeyPath = bru.getProcessEnv("KEYCHAIN_PRIVATE_RS256_KEY_PATH")
  const ecKeyPath = bru.getProcessEnv("KEYCHAIN_PRIVATE_ES256_KEY_PATH")
  const dpopAlg = ecKeyPath ? "ES256" : "<RS256|ES256>"
  const dpopKeyPath = ecKeyPath || "<path-to-private-key>"
  const dpopKeyHint = ecKeyPath
    ? ""
    : `   No DPoP key found in collections/.env. Generate an ES256 keypair first with \`pnpm generate-keypair --alg ES256\`, then:\n`
  const keychainId = bru.getVar("consumerKeychainId") || bru.getEnvVar("consumerKeychainId") || "<consumerKeychainId>"
  const purposeId = bru.getVar("purposeId") || bru.getEnvVar("purposeId") || "<purposeId>"
  const clientAssertionStep = rsaKeyPath
    ? `   pnpm generate-client-assertion --key ${rsaKeyPath} --keychainId ${keychainId} --purposeId ${purposeId}`
    : `   No RSA key found in collections/.env. Generate one first with \`pnpm generate-keypair\`, then run:\n` +
      `   pnpm generate-client-assertion --key $KEYCHAIN_PRIVATE_RS256_KEY_PATH --keychainId ${keychainId} --purposeId ${purposeId}`
  throw new Error(
    `Request failed with status ${res.status}.\n\n` +
    `1. Regenerate the client assertion (if missing or stale):\n` +
    `${clientAssertionStep}\n\n` +
    `2. Regenerate the DPoP proof (if missing or stale):\n` +
    `${dpopKeyHint}` +
    `   pnpm generate-dpop-proof --key ${dpopKeyPath} --alg ${dpopAlg} --htu https://test.knodia.org/token\n\n` +
    `Then re-run this call.`
  )
}
