meta {
  name: 1 - Get Mock Eservice (DPoP)
  type: http
  seq: 1
}

get {
  url: {{host-eservice-process}}/eservices/:eserviceId
  body: none
  auth: none
}

params:path {
  eserviceId: 905c4569-95db-4670-a146-8239fcb3f41a
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

assert {
  res.status: eq 200
}

vars:post-response {
  eserviceId: res.body.id
}

script:post-response {
  console.log(
    `\n==> eserviceId captured (${res.body.id}).\n` +
    "Now run the dpop-token-flow from step 2 (Get Eservice Latest Version) to step 11 (Create E-service Access Token), skipping step 1 (Create Eservice) — the flow will reuse this eserviceId.\n" +
    "Then re-sign a fresh DPoP proof bound to the access token and targeting GET /natural-persons/RMNLNR03H12H501Z/digital-contact (see this flow's README), and finally run step 2 of this flow (Get Digital Contact (DPoP)).\n"
  )
}
