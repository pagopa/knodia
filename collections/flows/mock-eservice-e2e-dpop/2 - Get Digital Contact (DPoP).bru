meta {
  name: 2 - Get Digital Contact (DPoP)
  type: http
  seq: 2
}

get {
  url: {{host-mock-eservice}}/natural-persons/RMNLNR03H12H501Z/digital-contact
  body: none
  auth: none
}

headers {
  Authorization: DPoP {{access_token}}
  DPoP: {{process.env.DPOP_PROOF_JWT}}
}

assert {
  res.status: eq 200
  res.body.naturalPerson.identifier.notation: eq RMNLNR03H12H501Z
  res.body.naturalPerson.familyName: eq Romano
  res.body.contactPoint.hasEmail: eq Leonardo.Romano@emailsample.org
}

script:pre-request {
  if (!bru.getVar("access_token") && !bru.getEnvVar("access_token")) {
    throw new Error(
      "access_token is not set. Run the dpop-token-flow (steps 2-11, skipping step 1) first — step 11 stashes the access_token."
    )
  }
}

script:post-response {
  if (res.status === 200) return

  const title = res.body && res.body.title
  if (title === "invalid_dpop_proof") {
    const ecKeyPath = bru.getProcessEnv("KEYCHAIN_PRIVATE_ES256_KEY_PATH")
    const dpopAlg = ecKeyPath ? "ES256" : "<RS256|ES256>"
    const dpopKeyPath = ecKeyPath || "<path-to-private-key>"
    const dpopKeyHint = ecKeyPath
      ? ""
      : `No DPoP key found in collections/.env. Generate an ES256 keypair first with \`pnpm generate-keypair --alg ES256\`, then:\n\n`
    const accessToken = bru.getVar("access_token") || bru.getEnvVar("access_token") || "<access_token>"
    throw new Error(
      `Request failed with status ${res.status} (${title}).\n\n` +
      `The DPoP proof is invalid. The most common cause is reusing the proof minted for step 11 (token endpoint).\n` +
      `Re-sign a fresh DPoP proof bound to the access token and targeting GET /natural-persons/RMNLNR03H12H501Z/digital-contact:\n\n` +
      `${dpopKeyHint}` +
      `  pnpm generate-dpop-proof --key ${dpopKeyPath} --alg ${dpopAlg} --htm GET --htu https://test.knodia.org/natural-persons/RMNLNR03H12H501Z/digital-contact --ath ${accessToken}\n\n` +
      `Then re-run this call.`
    )
  }

  throw new Error(
    `Request failed with status ${res.status}${title ? ` (${title})` : ""}.\n\n` +
    `If the access_token is expired, re-run the dpop-token-flow (steps 2-11, skipping step 1) to mint a fresh one and a new DPoP proof.`
  )
}
