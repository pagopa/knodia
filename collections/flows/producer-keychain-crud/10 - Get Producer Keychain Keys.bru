meta {
  name: 10 - Get Producer Keychain Keys
  type: http
  seq: 10
}

get {
  url: {{host-backend-for-frontend}}/producerKeychains/:producerKeychainId/keys?offset=0&limit=50
  body: none
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
}

params:query {
  offset: 0
  limit: 50
}

headers {
  Authorization: {{ui-session-jwt}}
}

assert {
  res.status: eq 200
  res.body.pagination.total: eq 1
}
