meta {
  name: 15 - Get Producer Keychain Members after Remove
  type: http
  seq: 15
}

get {
  url: {{host-backend-for-frontend}}/producerKeychains/:producerKeychainId/members?offset=0&limit=50
  body: none
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
}

params:query {
  offset: 0
  limit: 50
}

headers {
  Authorization: {{ui-session-jwt}}
}

assert {
  res.status: eq 200
  res.body.pagination.total: eq 0
}
