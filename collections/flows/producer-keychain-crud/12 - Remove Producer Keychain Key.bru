meta {
  name: 12 - Remove Producer Keychain Key
  type: http
  seq: 12
}

delete {
  url: {{host-backend-for-frontend}}/producerKeychains/:producerKeychainId/keys/:keyId
  body: none
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
  keyId: {{producerKeychainKeyId}}
}

headers {
  Authorization: {{ui-session-jwt}}
}

assert {
  res.status: eq 204
}
