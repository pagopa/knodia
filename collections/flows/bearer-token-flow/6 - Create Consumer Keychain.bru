meta {
  name: 6 - Create Consumer Keychain
  type: http
  seq: 6
}

post {
  url: {{host-keychain-process}}/consumerKeychains
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{randomKeychainName}}"
    },
    "description": {
      "en": "Keychain for the client-assertion flow"
    }
  }
}

vars:post-response {
  consumerKeychainId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomKeychainName", `Client Assertion Flow Keychain ${random}`)
}

script:post-response {
  await new Promise(r => setTimeout(r, 1500))
}
