meta {
  name: 11 - Create Token
  type: http
  seq: 11
}

post {
  url: {{host-authorization-server}}/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  client_assertion: {{process.env.CLIENT_ASSERTION_JWT}}
  client_assertion_type: urn:ietf:params:oauth:client-assertion-type:jwt-bearer
  client_id: {{consumerKeychainId}}
  grant_type: client_credentials
}

assert {
  res.status: eq 200
  res.body.token_type: eq Bearer
}

vars:post-response {
  access_token: res.body.access_token
}

script:post-response {
  if (res.status === 200) return

  const keyPath = bru.getProcessEnv("KEYCHAIN_PRIVATE_KEY_PATH") || "<path-to-private-key>"
  const keychainId = bru.getVar("consumerKeychainId") || bru.getEnvVar("consumerKeychainId") || "<consumerKeychainId>"
  const purposeId = bru.getVar("purposeId") || bru.getEnvVar("purposeId") || "<purposeId>"
  throw new Error(
    `Request failed with status ${res.status}. If you haven't signed a client assertion yet, or you rotated the keypair and the CLIENT_ASSERTION_JWT in collections/.env is stale, run:\n\n` +
    `  pnpm generate-client-assertion --key ${keyPath} --keychainId ${keychainId} --purposeId ${purposeId}\n\n` +
    "then re-run this call."
  )
}
