meta {
  name: 4 - Get Async Company Addresses Results (Async Consumption Bearer)
  type: http
  seq: 4
}

get {
  url: {{host-mock-eservice}}/legal-entities/address-requests/:companyAddressesRequestId/resources/:companyAddressesResourceId
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

params:path {
  companyAddressesRequestId: {{companyAddressesRequestId}}
  companyAddressesResourceId: {{companyAddressesResourceId}}
}

script:pre-request {
  if (!bru.getVar("access_token")) {
    throw new Error(
      "access_token is not set. Run authorization-server/Create E-service Access Token first — it populates the access_token var on success."
    )
  }
}

assert {
  res.status: eq 200
  res.body.results: isArray
  res.body.results.length: eq 3
}

script:post-response {
  const results = res.body.results
  const expected = [
    {
      identifier: "01229430085",
      legalEntity: {
        legalEntityActivity: "43.22.07",
        legalIdentifier: {
          notation: "01229430085",
          schemeName: "Partita Iva",
          schemeURI: "http://memberstate.ms/VAT",
        },
        legalName: "TUTTO - KLIMA SRL",
        registrationDate: "2012-07-09",
      },
    },
    {
      address: {
        adminUnitL1: "Italia",
        adminUnitL2: "Lazio",
        fullAddress: "Via Appia Nuova 12, 00100 Roma",
        postCode: "00100",
        postName: "Roma",
      },
      identifier: "12345678901",
      legalEntity: {
        legalEntityActivity: "01.11.00",
        legalIdentifier: {
          notation: "12345678901",
          schemeName: "Partita Iva",
          schemeURI: "http://memberstate.ms/VAT",
        },
        legalName: "Alfa Industria Srl",
        registrationDate: "1954-03-12",
      },
    },
    {
      identifier: "00000000000",
    },
  ]

  const actual = res.body.results
  if (JSON.stringify(actual) !== JSON.stringify(expected)) {
    throw new Error(
      "Unexpected async company-addresses results payload.\nExpected: " +
        JSON.stringify(expected, null, 2) +
        "\nActual: " +
        JSON.stringify(actual, null, 2)
    )
  }
}
