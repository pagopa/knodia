meta {
  name: 3 - Get Async Company Addresses Request Status
  type: http
  seq: 3
}

get {
  url: {{host-mock-eservice}}/legal-entities/address-requests/:companyAddressesRequestId
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

params:path {
  companyAddressesRequestId: {{companyAddressesRequestId}}
}

script:pre-request {
  if (!bru.getVar("access_token")) {
    throw new Error(
      "access_token is not set. Run authorization-server/Create E-service Access Token first — it populates the access_token var on success."
    )
  }
}

assert {
  res.status: eq 200
  res.body.status: matches /^(PENDING|COMPLETED)$/
}

script:post-response {
  const status = res.body.status
  const resourceId = res.body.resourceId

  if (status === "COMPLETED") {
    if (!resourceId) {
      throw new Error(
        `Expected a valid resourceId when status is COMPLETED. Got: ${resourceId}`
      )
    }

    bru.setVar("companyAddressesResourceId", resourceId)
  }
}
