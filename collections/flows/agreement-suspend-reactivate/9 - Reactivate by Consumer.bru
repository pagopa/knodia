meta {
  name: 9 - Reactivate by Consumer
  type: http
  seq: 9
}

post {
  url: {{host-agreement-process}}/agreements/:agreementId/consumer/reactivate
  body: none
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{internal-jwt}}
}

assert {
  res.status: eq 200
  res.body.state: eq Suspended
  res.body.suspendedByConsumerAt: isNull
  res.body.suspendedByProducerAt: isDefined
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
