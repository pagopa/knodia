meta {
  name: 6 - Reactivate by Producer
  type: http
  seq: 6
}

post {
  url: {{host-agreement-process}}/agreements/:agreementId/producer/reactivation
  body: none
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{internal-jwt}}
}

assert {
  res.status: eq 200
  res.body.state: eq Active
  res.body.suspendedByProducerAt: isNull
  res.body.suspendedByConsumerAt: isNull
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
