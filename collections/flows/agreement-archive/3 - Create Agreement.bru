meta {
  name: 3 - Create Agreement
  type: http
  seq: 3
}

post {
  url: {{host-agreement-process}}/agreements
  body: json
  auth: none
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{internal-jwt}}
}

body:json {
  {
    "consumer": {
      "attributes": [
        { "code": "nuts3", "scheme": "vc_territorial_units" }
      ],
      "id": "{{organizationId}}",
      "knodeId": "{{other-knode-id}}"
    },
    "eserviceId": "{{eserviceId}}",
    "eserviceVersionId": "{{eserviceVersionId}}"
  }
}

vars:pre-request {
  organizationId: 00000000-0000-4000-8000-000000000004
}

vars:post-response {
  agreementId: res.body.id
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
