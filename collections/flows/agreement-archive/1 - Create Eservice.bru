meta {
  name: 1 - Create Eservice
  type: http
  seq: 1
}

post {
  url: {{host-eservice-process}}/eservices
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{randomName}}"
    },
    "description": {
      "en": "Eservice for agreement archive flow"
    },
    "accessTokenAudience": ["https://api.example.com"],
    "accessTokenDuration": 3600,
    "accessTokenType": "Bearer",
    "maxDailyCallsPerConsumer": 1000,
    "maxDailyCallsPerKnode": 10000,
    "requiredAttributes": [
      [
        {
          "code": "nuts3",
          "scheme": "vc_territorial_units"
        }
      ]
    ],
    "mode": "ProvideData",
    "categories": [
      {
        "code": "citizen.identity.birth_date",
        "scheme": "vc_example_eservice_categories"
      }
    ],
    "isSignalHubEnabled": false,
    "interfaceDocument": {
      "checksum": "fbbd4b8920b1b58182256060d2918763f922dd09f7a2274118d8c990ddcf0800",
      "contentType": "application/yaml",
      "id": "{{$randomUUID}}",
      "name": "openapi.yaml",
      "path": "/interfaces/openapi.yaml",
      "prettyName": {
        "en": "Test Interface"
      }
    }
  }
}

vars:post-response {
  eserviceId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomName", `Test Eservice ${random}`)
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
