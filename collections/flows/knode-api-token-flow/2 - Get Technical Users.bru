meta {
  name: 2 - Get Technical Users
  type: http
  seq: 2
}

get {
  url: {{host-backend-for-frontend}}/operators
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

vars:post-response {
  userId: res.body.find(u => u.roles.includes("technical")).id
}
