meta {
  name: 4 - Upload Keychain Key
  type: http
  seq: 4
}

post {
  url: {{host-keychain-process}}/knodeApiKeychains/:knodeApiKeychainId/keys
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  knodeApiKeychainId: {{knodeApiKeychainId}}
}

body:json {
  {
    "name": {
      "en": "Knode API Token Flow Key"
    },
    "encodedPem": "{{process.env.KEYCHAIN_PUBLIC_RS256_KEY_B64}}"
  }
}

script:post-response {
  if (res.status === 201) {
    await new Promise(r => setTimeout(r, 1500))
    return
  }

  throw new Error(
    `Request failed with status ${res.status}. If you haven't generated a keypair yet, or you need a fresh one because the current kid already exists in another keychain, run:\n\n` +
    "  pnpm generate-keypair\n\n" +
    "then re-run the flow."
  )
}
