meta {
  name: 10 - Suspend by Producer (escalate)
  type: http
  seq: 10
}

post {
  url: {{host-purpose-process}}/purposes/:purposeId/suspendByProducer
  body: none
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}

assert {
  res.status: eq 200
  res.body.state: eq Suspended
  res.body.suspendedByConsumerAt: isDefined
  res.body.suspendedByProducerAt: isDefined
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
