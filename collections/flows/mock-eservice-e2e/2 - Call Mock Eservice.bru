meta {
  name: 2 - Call Mock Eservice
  type: http
  seq: 2
}

get {
  url: {{host-mock-eservice}}/test
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

script:pre-request {
  if (!bru.getVar("access_token")) {
    throw new Error(
      "access_token is not set. Run the client-assertion-flow (steps 3-12, skipping step 2) first — step 12 stashes the access_token."
    )
  }
}
