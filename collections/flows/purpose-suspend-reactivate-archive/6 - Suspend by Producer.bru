meta {
  name: 6 - Suspend by Producer
  type: http
  seq: 6
}

post {
  url: {{host-purpose-process}}/purposes/:purposeId/suspendByProducer
  body: none
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}

assert {
  res.status: eq 200
  res.body.state: eq Suspended
  res.body.suspendedByProducerAt: isDefined
  res.body.suspendedByConsumerAt: isNull
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
