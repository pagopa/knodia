meta {
  name: 11 - Link Purpose To Keychain
  type: http
  seq: 11
}

post {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId/purposes
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
}

body:json {
  {
    "knodeId": "{{other-knode-id}}",
    "purposeId": "{{purposeId}}"
  }
}

script:post-response {
  await new Promise(r => setTimeout(r, 1500))
}
