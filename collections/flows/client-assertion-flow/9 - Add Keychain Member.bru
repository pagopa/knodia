meta {
  name: 9 - Add Keychain Member
  type: http
  seq: 9
}

post {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId/members
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
}

body:json {
  {
    "userId": "{{userId}}"
  }
}

script:post-response {
  await new Promise(r => setTimeout(r, 2000))
}
