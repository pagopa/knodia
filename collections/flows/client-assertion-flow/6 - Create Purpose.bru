meta {
  name: 6 - Create Purpose
  type: http
  seq: 6
}

post {
  url: {{host-remote-resources-manager}}/purposes
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "Client Assertion Flow Purpose"
    },
    "description": {
      "en": "Purpose for the client-assertion flow"
    },
    "eserviceId": "{{eserviceId}}",
    "knodeId": "{{other-knode-id}}",
    "dailyCalls": 100,
    "formAnswersJson": {
      "checkedExistenceMereCorrectnessInteropCatalogue": "true",
      "confirmPrincipleIntegrityAndDiscretion": "true",
      "dataDownload": "NO",
      "declarationConfirmGDPR": "true",
      "deliveryMethod": "CLEARTEXT",
      "doneDpia": "NO",
      "institutionalPurpose": "Client assertion flow",
      "isRequestOnBehalfOfThirdParties": "NO",
      "knowsDataQuantity": "NO",
      "legalBasis": ["CONSENT"],
      "personalDataTypes": ["WITH_IDENTIFYING_DATA"],
      "policyProvided": "YES",
      "policyProvidedMedium": "PRINT",
      "purpose": "INSTITUTIONAL",
      "purposePursuit": "MERE_CORRECTNESS",
      "usesPersonalData": "YES"
    },
    "formSchemaVersion": "{{purposeFormSchemasVersion}}"
  }
}

vars:post-response {
  purposeId: res.body.id
}

script:post-response {
  await new Promise(r => setTimeout(r, 1500))
}
