meta {
  name: 0 - Get Organizations
  type: http
  seq: 0
}

get {
  url: {{host-organization-process}}/organizations?offset=0&limit=50
  body: none
  auth: none
}

params:query {
  offset: 0
  limit: 50
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

vars:post-response {
  organizationId: res.body.results[0].id
}
