meta {
  name: 7 - Get Purpose Form Schemas
  type: http
  seq: 7
}

get {
  url: {{host-purpose-process}}/purposes/formSchemas/current
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}

vars:post-response {
  purposeFormSchemaVersion: res.body.version
}
