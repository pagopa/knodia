meta {
  name: 5 - Create Agreement
  type: http
  seq: 5
}

post {
  url: {{host-agreement-process}}/agreements
  body: json
  auth: none
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{internal-jwt}}
}

body:json {
  {
    "consumer": {
      "attributes": [
        { "code": "nuts3", "scheme": "vc_territorial_units" }
      ],
      "id":"{{organizationId}}",
      "knodeId": "{{other-knode-id}}"
    },
    "eserviceId": "{{eserviceId}}",
    "eserviceVersionId": "{{eserviceVersionId}}"
  }
}

vars:post-response {
  agreementId: res.body.id
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
