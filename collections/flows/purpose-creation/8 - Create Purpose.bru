meta {
  name: 8 - Create Purpose
  type: http
  seq: 8
}

post {
  url: {{host-purpose-process}}/purposes
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}

body:json {
  {
    "consumer": {
      "id": "{{organizationId}}",
      "knodeId": "{{other-knode-id}}"
    },
    "dailyCalls": 1000,
    "description": {
      "en": "Test purpose for local development"
    },
    "eserviceId": "{{eserviceId}}",
    "formAnswersJson": {
      "checkedExistenceMereCorrectnessInteropCatalogue": "true",
      "confirmPrincipleIntegrityAndDiscretion": "true",
      "dataDownload": "NO",
      "declarationConfirmGDPR": "true",
      "deliveryMethod": "CLEARTEXT",
      "doneDpia": "NO",
      "institutionalPurpose": "Test purpose for local development",
      "isRequestOnBehalfOfThirdParties": "NO",
      "knowsDataQuantity": "NO",
      "legalBasis": ["CONSENT"],
      "personalDataTypes": ["WITH_IDENTIFYING_DATA"],
      "policyProvided": "YES",
      "policyProvidedMedium": "PRINT",
      "purpose": "INSTITUTIONAL",
      "purposePursuit": "MERE_CORRECTNESS",
      "usesPersonalData": "YES"
    },
    "formSchemaVersion": "{{purposeFormSchemasVersion}}",
    "name": {
      "en": "My Test Purpose"
    }
  }
}

vars:post-response {
  purposeId: res.body.id
}

script:post-response {
  await new Promise(r => setTimeout(r, 1000))
}
