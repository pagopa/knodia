meta {
  name: 4 - Get Eservice Latest Version
  type: http
  seq: 4
}

get {
  url: {{host-eservice-process}}/eservices/:eserviceId/versions/latest
  body: none
  auth: none
}

params:path {
  eserviceId: {{eserviceId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

vars:post-response {
  eserviceVersionId: res.body.id
}
