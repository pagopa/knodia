meta {
  name: 1 - Get Mock Eservice (Signal Hub Bearer)
  type: http
  seq: 1
}

get {
  url: {{host-eservice-process}}/eservices/:eserviceId
  body: none
  auth: none
}

params:path {
  eserviceId: 634ac97e-47cb-4aed-bb0a-b3936ee6f6c7
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

assert {
  res.status: eq 200
}

vars:post-response {
  eserviceId: res.body.id
}

script:post-response {
  console.log(
    `\n==> eserviceId captured (${res.body.id}).\n` +
    "Now run the bearer-token-flow from step 2 (Get Eservice Latest Version) to step 11 (Create Token), skipping step 1 (Create Eservice) — the flow will reuse this eserviceId.\n" +
    "When it's done, run step 2 of this flow (Get Residence), then step 3 (Get Pseudonymization).\n"
  )
}
