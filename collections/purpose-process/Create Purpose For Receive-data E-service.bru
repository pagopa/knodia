meta {
  name: Create Purpose For Receive-data E-service
  type: http
}

post {
  url: {{host-purpose-process}}/purposes
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}

body:json {
  {
    "consumer": {
      "id": "{{organizationId}}",
      "knodeId": "{{other-knode-id}}"
    },
    "dailyCalls": 1000,
    "description": {
      "en": "Test purpose for a Receive-data E-service"
    },
    "eserviceId": "{{eserviceId}}",
    "eserviceMode": "ReceiveData",
    "name": {
      "en": "My Test Purpose For Receive-data E-service"
    },
    "purposeFormOptionId": "{{purposeFormOptionId}}"
  }
}

vars:post-response {
  purposeId: res.body.id
}
