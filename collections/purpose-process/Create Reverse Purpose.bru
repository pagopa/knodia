meta {
  name: Create Reverse Purpose
  type: http
}

post {
  url: {{host-purpose-process}}/purposes/receive-mode
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}

body:json {
  {
    "consumer": {
      "id": "{{organizationId}}",
      "knodeId": "{{other-knode-id}}"
    },
    "dailyCalls": 1000,
    "description": {
      "en": "Test reverse purpose for local development"
    },
    "eserviceId": "{{eserviceId}}",
    "name": {
      "en": "My Test Reverse Purpose"
    },
    "purposeFormAnswerId": "{{purposeFormAnswerId}}"
  }
}

vars:post-response {
  purposeId: res.body.id
}
