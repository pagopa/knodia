meta {
  name: Get Form UI Schema
  type: http
}

get {
  url: {{host-purpose-process}}/purposes/formSchemas/current/ui
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}

vars:post-response {
  purposeFormSchemaVersion: res.body.version
}
