meta {
  name: Reactivate Purpose by Producer
  type: http
}

post {
  url: {{host-purpose-process}}/purposes/:purposeId/reactivateByProducer
  body: none
  auth: none
}

params:path {
  purposeId: {{purposeId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}
