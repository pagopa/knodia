meta {
  name: Suspend Agreement by Producer
  type: http
}

post {
  url: {{host-agreement-process}}/agreements/:agreementId/suspendByProducer
  body: none
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}
