meta {
  name: Reactivate Agreement
  type: http
}

post {
  url: {{host-agreement-process}}/agreements/:agreementId/reactivate
  body: json
  auth: none
}

params:path {
  agreementId: {{agreementId}}
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{internal-jwt}}
}

body:json {
  {
    "reactivatedBy": "producer"
  }
}
