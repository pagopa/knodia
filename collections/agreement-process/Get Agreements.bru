meta {
  name: Get Agreements
  type: http
}

get {
  url: {{host-agreement-process}}/agreements?limit=50&offset=0
  body: none
  auth: none
}

params:query {
  limit: 50
  offset: 0
  ~consumerId: {{organizationId}}
  ~consumerKnodeId: {{other-knode-id}}
  ~eserviceId: {{eserviceId}}
  ~producerId: {{organizationId}}
  ~state: Active
  ~updatedSince: 2026-04-13T00:00:00.000Z
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{ui-session-jwt}}
}

vars:post-response {
  agreementId: res.body.results[0].id
}
