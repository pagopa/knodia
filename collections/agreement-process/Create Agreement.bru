meta {
  name: Create Agreement
  type: http
  seq: 1
}

post {
  url: {{host-agreement-process}}/agreements
  body: json
  auth: none
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{internal-jwt}}
}

body:json {
  {
    "consumer": {
      "id":"{{consumerId}}",
      "knodeId": "Orion"
    },
    "eserviceId": "{{eserviceId}}",
    "eserviceVersionId": "{{eserviceVersionId}}"
  }
}

vars:post-response {
  agreementId: res.body.id
}
