meta {
  name: Create Agreement
  type: http
}

post {
  url: {{host-agreement-process}}/agreements
  body: json
  auth: none
}

headers {
  x-correlation-id: {{correlation-id}}
  authorization: {{internal-jwt}}
}

body:json {
  {
    "consumer": {
      "id":"{{organizationId}}",
      "knodeId": "{{other-knode-id}}"
    },
    "consumerAttributes": [
      { "code": "nuts1", "scheme": "nuts" },
      { "code": "nuts2", "scheme": "nuts" }
    ],
    "eserviceId": "{{eserviceId}}",
    "eserviceVersionId": "{{eserviceVersionId}}"
  }
}

vars:post-response {
  agreementId: res.body.id
}
