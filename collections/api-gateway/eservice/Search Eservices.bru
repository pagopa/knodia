meta {
  name: Search Eservices
  type: http
  seq: 1
}

post {
  url: {{host-knodia-api-gateway}}/searchEservices
  body: json
}

body:json {
  {
    "keywords": "test"
  }
}

params:query {
  offset: 0
  limit: 50
}

vars:post-response {
  total: res.body.pagination.total
  eservices: res.body.results
}
