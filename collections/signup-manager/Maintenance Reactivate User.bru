meta {
  name: Maintenance Reactivate User
  type: http
  seq: 1
}

post {
  url: {{host-signup-manager}}/maintenance/users/:signupUserId/reactivate
  body: none
  auth: none
}

params:path {
  signupUserId: {{signupUserId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{maintenance-jwt}}
}
