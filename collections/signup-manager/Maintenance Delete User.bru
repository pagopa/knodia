meta {
  name: Maintenance Delete User
  type: http
}

post {
  url: {{host-signup-manager}}/maintenance/users/:signupUserId/delete
  body: none
  auth: none
}

params:path {
  signupUserId: {{signupUserId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{maintenance-jwt}}
}

