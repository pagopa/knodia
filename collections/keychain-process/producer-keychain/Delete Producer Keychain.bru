meta {
  name: Delete Producer Keychain
  type: http
}

delete {
  url: {{host-keychain-process}}/producerKeychains/:producerKeychainId
  body: none
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}
