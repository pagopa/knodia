meta {
  name: Create Producer Keychain
  type: http
}

post {
  url: {{host-keychain-process}}/producerKeychains
  body: json
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{randomName}}"
    },
    "description": {
      "en": "This is a test producer keychain"
    }
  }
}

vars:post-response {
  producerKeychainId: res.body.id
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("randomName", `Test Producer Keychain ${random}`)
}
