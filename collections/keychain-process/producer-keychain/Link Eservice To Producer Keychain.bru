meta {
  name: Link Eservice To Producer Keychain
  type: http
}

post {
  url: {{host-keychain-process}}/producerKeychains/:producerKeychainId/eservices
  body: json
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "eserviceId": "{{eserviceId}}"
  }
}
