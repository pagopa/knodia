meta {
  name: Get Producer Keychain Keys
  type: http
}

get {
  url: {{host-keychain-process}}/producerKeychains/:producerKeychainId/keys?offset=0&limit=50
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  producerKeychainId: {{producerKeychainId}}
}

params:query {
  offset: 0
  limit: 50
}
