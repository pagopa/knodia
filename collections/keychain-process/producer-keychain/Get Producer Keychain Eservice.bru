meta {
  name: Get Producer Keychain Eservice
  type: http
}

get {
  url: {{host-keychain-process}}/producerKeychains/:producerKeychainId/eservices/:eserviceId
  body: none
  auth: none
}

params:path {
  producerKeychainId: {{producerKeychainId}}
  eserviceId: {{eserviceId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}
