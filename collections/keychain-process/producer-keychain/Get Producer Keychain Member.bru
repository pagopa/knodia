meta {
  name: Get Producer Keychain Member
  type: http
}

get {
  url: {{host-keychain-process}}/producerKeychains/:producerKeychainId/members/:userId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  producerKeychainId: {{producerKeychainId}}
  userId: {{userId}}
}
