meta {
  name: Remove Producer Keychain Key
  type: http
}

delete {
  url: {{host-keychain-process}}/producerKeychains/:producerKeychainId/keys/:keyId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  producerKeychainId: {{producerKeychainId}}
  keyId: {{producerKeychainKeyId}}
}
