meta {
  name: Get Knodia API Keychain Member
  type: http
}

get {
  url: {{host-keychain-process}}/knodiaApiKeychains/:knodiaApiKeychainId/members/:userId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  knodiaApiKeychainId: {{knodiaApiKeychainId}}
  userId: {{userId}}
}
