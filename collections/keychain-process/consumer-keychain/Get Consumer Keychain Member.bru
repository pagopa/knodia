meta {
  name: Get Consumer Keychain Member
  type: http
}

get {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId/members/:userId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
  userId: {{userId}}
}
