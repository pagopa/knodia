meta {
  name: Get Consumer Keychain Members
  type: http
}

get {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId/members?offset=0&limit=50
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:query {
  offset: 0
  limit: 50
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
}
