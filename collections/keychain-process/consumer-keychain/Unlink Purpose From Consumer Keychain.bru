meta {
  name: Unlink Purpose From Consumer Keychain
  type: http
}

delete {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId/purposes/:purposeId?knodeId={{other-knode-id}}
  body: none
  auth: none
}

params:query {
  knodeId: {{other-knode-id}}
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
  purposeId: {{purposeId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}
