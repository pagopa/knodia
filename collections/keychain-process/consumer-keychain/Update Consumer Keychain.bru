meta {
  name: Update Consumer Keychain
  type: http
}

patch {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId
  body: json
  auth: none
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
}

headers {
  Content-Type: application/merge-patch+json
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{updatedConsumerKeychainName}}"
    },
    "description": null
  }
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("updatedConsumerKeychainName", bru.getEnvVar("fixedName") || `Updated Consumer Keychain ${random}`)
}
