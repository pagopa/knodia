meta {
  name: Remove Consumer Keychain Key
  type: http
}

delete {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId/keys/:keyId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
  keyId: {{consumerKeychainKeyId}}
}
