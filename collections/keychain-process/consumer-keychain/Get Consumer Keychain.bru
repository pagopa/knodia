meta {
  name: Get Consumer Keychain
  type: http
}

get {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId
  body: none
  auth: none
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}
