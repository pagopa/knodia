meta {
  name: Remove Knodia API Keychain Key
  type: http
}

delete {
  url: {{host-keychain-process}}/knodiaApiKeychains/:knodiaApiKeychainId/keys/:keyId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  knodiaApiKeychainId: {{knodiaApiKeychainId}}
  keyId: {{keyId}}
}
