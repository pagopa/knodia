meta {
  name: Update Knodia API Keychain
  type: http
}

patch {
  url: {{host-keychain-process}}/knodiaApiKeychains/:knodiaApiKeychainId
  body: json
  auth: none
}

params:path {
  knodiaApiKeychainId: {{knodiaApiKeychainId}}
}

headers {
  Content-Type: application/merge-patch+json
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{updatedKnodiaApiKeychainName}}"
    },
    "description": null
  }
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("updatedKnodiaApiKeychainName", `Updated Knodia API Keychain ${random}`)
}
