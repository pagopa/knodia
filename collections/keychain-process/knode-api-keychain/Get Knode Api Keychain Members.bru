meta {
  name: Get Knode Api Keychain Members
  type: http
}

get {
  url: {{host-keychain-process}}/knodeApiKeychains/:knodeApiKeychainId/members?offset=0&limit=50
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:query {
  offset: 0
  limit: 50
}

params:path {
  knodeApiKeychainId: {{knodeApiKeychainId}}
}
