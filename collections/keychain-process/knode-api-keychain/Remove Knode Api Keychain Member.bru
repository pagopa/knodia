meta {
  name: Remove Knode Api Keychain Member
  type: http
}

delete {
  url: {{host-keychain-process}}/knodeApiKeychains/:knodeApiKeychainId/members/:userId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  knodeApiKeychainId: {{knodeApiKeychainId}}
  userId: {{userId}}
}
