meta {
  name: Remove Knode Api Keychain Key
  type: http
}

delete {
  url: {{host-keychain-process}}/knodeApiKeychains/:knodeApiKeychainId/keys/:keyId
  body: none
  auth: none
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

params:path {
  knodeApiKeychainId: {{knodeApiKeychainId}}
  keyId: {{knodeApiKeychainKeyId}}
}
