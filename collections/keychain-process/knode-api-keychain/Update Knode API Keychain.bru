meta {
  name: Update Knode API Keychain
  type: http
}

patch {
  url: {{host-keychain-process}}/knodeApiKeychains/:knodeApiKeychainId
  body: json
  auth: none
}

params:path {
  knodeApiKeychainId: {{knodeApiKeychainId}}
}

headers {
  Content-Type: application/merge-patch+json
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{ui-session-jwt}}
}

body:json {
  {
    "name": {
      "en": "{{updatedKnodeApiKeychainName}}"
    },
    "description": null
  }
}

script:pre-request {
  const random = Math.round(Math.random() * 1000)
  bru.setVar("updatedKnodeApiKeychainName", bru.getEnvVar("fixedName") || `Updated Knode API Keychain ${random}`)
}
