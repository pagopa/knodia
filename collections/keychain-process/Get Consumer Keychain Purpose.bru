meta {
  name: Get Consumer Keychain Purpose
  type: http
}

get {
  url: {{host-keychain-process}}/consumerKeychains/:consumerKeychainId/purposes/:purposeId?knodeId=Orion
  body: none
  auth: none
}

params:query {
  knodeId: Orion
}

params:path {
  consumerKeychainId: {{consumerKeychainId}}
  purposeId: {{purposeId}}
}

headers {
  X-Correlation-Id: {{correlation-id}}
  Authorization: {{internal-jwt}}
}
