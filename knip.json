{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "tags": ["-knipignore"],
  "includeEntryExports": true,
  "ignoreIssues": {
    "packages/models/common-models/src/ids/brandedIds.ts": ["exports", "types"],
    "packages/models/terms-and-conditions-models/src/schema.ts": ["exports", "types"],
    "packages/models/terms-and-conditions-models/src/canonical.ts": ["exports"],
    "packages/models/terms-and-conditions-models/src/date.ts": ["exports", "types"],
    "packages/models/terms-and-conditions-models/src/version.ts": ["exports"],
    "packages/models/terms-and-conditions-models/src/content.ts": ["exports"]
  },
  "workspaces": {
    ".": {
      "ignore": [
        "docker/multinode/env-*.js",
        "poc-use-cases/**",
        "scripts/eservice-consumption/**",
        "scripts/local-auth/kms-setup.mjs",
        "scripts/local-auth/local-cognito.mjs",
        "scripts/local-auth/local-one-identity.mjs"
      ]
    },
    "packages/clients/**/*": {
      "entry": ["src/generated/**/*.ts"],
      "ignore": ["src/generated/**/*.ts"]
    },
    "packages/models/*-models": {
      "entry": ["src/generated/**/*.ts"],
      "ignore": ["src/generated/**/*.ts"]
    },
    "apps/services/backend-for-frontend": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/k2k-gateway": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/k2o-gateway": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/authorization-server": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/mock-eservice": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/signal-hub": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/*-process": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/*-manager": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/web/*-frontend": {
      "ignore": ["src/routeTree.gen.ts", "public/**/*"],
      "ignoreDependencies": [
        "babel-plugin-react-compiler",
        "@theme.css",
        "@fontsource-variable/instrument-sans",
        "@fontsource/titillium-web"
      ]
    },
    "packages/ui-kit": {
      "ignoreUnresolved": ["packages\\/ui-kit\\/.*\\.\\{ts,tsx\\}"]
    }
  }
}
