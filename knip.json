{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {},
    "packages/*-process-client": {
      "entry": ["src/generated/**/*.ts"],
      "ignore": ["src/generated/**/*.ts"],
      "ignoreDependencies": ["axios"]
    },
    "packages/models/*-models": {
      "entry": ["src/generated/**/*.ts"],
      "ignore": ["src/generated/**/*.ts"]
    },
    "apps/services/backend-for-frontend": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/services/*-process": {
      "entry": ["tests/**/*.ts"],
      "ignoreDependencies": ["@knodia/spectral-config"]
    },
    "apps/web/**/*": {
      "ignore": ["src/routeTree.gen.ts"],
      "ignoreDependencies": ["babel-plugin-react-compiler"]
    },
    "packages/ui-kit": {
      "ignoreUnresolved": ["packages\\/ui-kit\\/.*\\.\\{ts,tsx\\}"]
    }
  }
}
