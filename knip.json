{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {},
    "packages/*-process-client": {
      "entry": ["src/generated/**/*.ts"]
    },
    "packages/models/*-models": {
      "entry": ["src/generated/*.ts"]
    }
  }
}
