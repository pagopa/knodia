{
  "extends": [
    "github>pagopa/eng-renovate",
    ":combinePatchMinorReleases",
    ":ignoreUnstable",
    ":rebaseStalePrs",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": true,
  "prCreation": "immediate",
  "minimumReleaseAge": null,
  "prConcurrentLimit": 4,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "enabled": true,
      "matchDepTypes": ["devDependencies"]
    },
    {
      "enabled": true,
      "matchDepTypes": ["pnpm.catalog"]
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": ["*"],
      "prCreation": "immediate",
      "internalChecksFilter": "strict",
      "internalChecksAsSuccess": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "major": {
    "enabled": true
  },
  "minor": {
    "enabled": true
  },
  "patch": {
    "enabled": true
  },
  "digest": {
    "enabled": true
  },
  "rollback": {
    "enabled": true
  },
  "replacement": {
    "enabled": true
  }
}
