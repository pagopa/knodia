{
  "extends": [
    "github>pagopa/eng-renovate",
    ":combinePatchMinorReleases",
    ":ignoreUnstable",
    ":rebaseStalePrs",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "enabled": true,
      "matchDepTypes": ["devDependencies"]
    },
    {
      "enabled": true,
      "matchDepTypes": ["pnpm.catalog"]
    }
  ],
  "prConcurrentLimit": 4,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "none",
  "prCreation": "immediate",
  "lockFileMaintenance": {
    "enabled": true
  },
  "major": {
    "enabled": true
  },
  "minor": {
    "enabled": true
  },
  "patch": {
    "enabled": true
  },
  "digest": {
    "enabled": true
  },
  "rollback": {
    "enabled": true
  },
  "replacement": {
    "enabled": true
  }
}
