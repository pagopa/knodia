{
  "name": "knodia-monorepo",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "start": "NODE_OPTIONS='--max-old-space-size=150' turbo run start",
    "start:services": "NODE_OPTIONS='--max-old-space-size=150' turbo run start --concurrency=25 --filter='./apps/**/*'",
    "start:process": "NODE_OPTIONS='--max-old-space-size=150' turbo run start --filter @knodia/*-process",
    "start:rmw": "NODE_OPTIONS='--max-old-space-size=150' turbo run start --filter @knodia/*-readmodel-writer",
    "generate-api-client": "turbo run generate-api-client",
    "generate-openapi": "turbo run generate-openapi",
    "generate-protobuf": "turbo run generate-protobuf",
    "generate-artifacts": "turbo run generate-artifacts",
    "generate-bruno-collection": "node ./tools/bruno-collection-generator/src/cli.ts",
    "lint": "turbo run lint",
    "lint:autofix": "turbo run lint:autofix",
    "lint-openapi": "turbo run lint-openapi",
    "dev:storybook": "turbo run dev:storybook",
    "build:storybook": "turbo run build:storybook",
    "db:drizzle-pull": "turbo run db:drizzle-pull",
    "db:generate-schema": "turbo run db:generate-schema",
    "db:schema-normalize": "turbo run db:schema-normalize",
    "knip": "dotenvx run --env-file .env.test -- knip",
    "consume-eservice": "node scripts/eservice-consumption/consume-eservice.ts",
    "decode-jwt": "node scripts/eservice-consumption/decode-jwt.ts",
    "generate-client-assertion": "node scripts/local-auth/generate-client-assertion.ts",
    "generate-dpop-proof": "node scripts/local-auth/generate-dpop-proof.ts",
    "generate-keypair": "node scripts/local-auth/generate-keypair.ts",
    "generate-token": "node scripts/local-auth/generate-token.mjs",
    "generate-all-tokens": "node scripts/local-auth/generate-all-tokens.mjs",
    "derive-integrity-producer-key": "node scripts/seed/derive-integrity-producer-key.ts",
    "infra:start": "./scripts/infra-start.sh",
    "infra:stop": "./scripts/infra-stop.sh",
    "infra:destroy": "./scripts/infra-destroy.sh",
    "multinode:start": "./scripts/infra-start-multinode.sh",
    "multinode:stop": "./scripts/infra-stop-multinode.sh",
    "multinode:destroy": "./scripts/infra-destroy-multinode.sh",
    "prune-modules": "find . -name 'node_modules' -type d -exec rm -rf {} +",
    "test": "vitest run",
    "test:watch": "vitest run --watch"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@types/node": "catalog:",
    "knip": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "engines": {
    "node": ">=24"
  }
}
