{
  "extends": [
    "./tsconfig.base.json",
    "@tsconfig/node24/tsconfig.json",
    "@tsconfig/node-ts/tsconfig.json"
  ],
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true, // typecheck only, we don't transpile into JS, we run TS directly with Node.js
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
      // TODO ^ required for hey-api generated clients to compile.
      // Drop after issue is fixed: https://github.com/hey-api/openapi-ts/issues/2539
    ]
  }
}
