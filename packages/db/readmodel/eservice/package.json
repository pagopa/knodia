{
  "name": "@knodia/db-readmodel-eservice",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:autofix": "eslint . --fix",
    "db:generate": "dotenvx run -- drizzle-kit generate --name=readmodel-eservice",
    "db:migrate": "dotenvx run -- drizzle-kit migrate"
