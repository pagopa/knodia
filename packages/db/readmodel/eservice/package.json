    "@knodia/db-readmodel-config": "workspace:*",
    "@dotenvx/dotenvx": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/eservice.ts",
    "./config": "./config/config.ts"
  }
}
