{
  "name": "@knodia/db-readmodel-organization",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:autofix": "eslint . --fix",
    "db:drizzle-pull": "dotenvx run -- drizzle-kit pull",
    "db:generate-schema": "pnpm run db:drizzle-pull && pnpm run db:schema-normalize",
    "db:schema-normalize": "node ../../../../scripts/normalize-drizzle-output.ts"
  },
  "dependencies": {
    "@knodia/common-models": "workspace:*",
    "@knodia/db-readmodel-commons": "workspace:*",
    "@knodia/db-readmodel-config": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@knodia/eslint-config": "workspace:*",
    "@knodia/organization-models": "workspace:*",
    "@knodia/typescript-config": "workspace:*",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": "./src/organization.ts",
    "./config": "./config/config.ts",
    "./services": "./src/services/readmodelService.ts"
  }
}
