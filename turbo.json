{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["build", "^lint"]
    },
    "lint:autofix": {
      "dependsOn": ["build"],
      "outputs": ["dist"]
    }
  }
}
