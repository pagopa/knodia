{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^typecheck"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "generate-api-client": {
      "outputs": ["src/generated/**"]
    },
    "generate-openapi": {
      "outputs": ["openapi/openapi.yaml"]
    },
    "generate-protobuf": {
      "outputs": ["src/generated/*"]
    },
    "lint": {},
    "lint:autofix": {},
    "lint-openapi": {},
    "generate-artifacts": {
      "dependsOn": ["generate-api-client", "generate-protobuf"]
    },
    "dev:storybook": {},
    "build:storybook": {},
    "db:drizzle-pull": {
      "cache": false
    },
    "db:generate-schema": {
      "cache": false
    },
    "db:schema-normalize": {
      "cache": false
    }
  }
}
