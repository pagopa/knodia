{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate-openapi", "generate-protobuf", "db:migrate"]
    },
    "typecheck": {
      "dependsOn": ["generate-protobuf", "^typecheck"]
    },
    "generate-openapi": {
      "outputs": ["openapi/openapi.yaml"]
    },
    "lint": {},
    "lint:autofix": {},
    "db:generate": {
      "outputs": ["drizzle/**"]
    },
    "db:migrate": {},
    "generate-protobuf": {
      "outputs": ["src/generated/*"]
    },
    "build-knip-dependencies": {
      "dependsOn": ["generate-protobuf"]
    }
  }
}
