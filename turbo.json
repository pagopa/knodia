{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^typecheck", "//#infra:start"]
    },
    "typecheck": {
      "dependsOn": ["generate-protobuf", "^generate-api-client", "^typecheck"]
    },
    "generate-api-client": {
      "dependsOn": ["^generate-protobuf"],
      "outputs": ["src/generated/**"]
    },
    "generate-openapi": {
      "outputs": ["openapi/openapi.yaml"]
    },
    "generate-protobuf": {
      "dependsOn": ["^generate-protobuf"],
      "outputs": ["src/generated/*"]
    },
    "lint": {},
    "lint:autofix": {},
    "lint-openapi": {
      "dependsOn": ["generate-openapi"]
    },
    "generate-artifacts": {
      "dependsOn": ["generate-api-client"]
    },
    "dev:storybook": {},
    "build:storybook": {},
    "//#infra:start": {
      "cache": false
    },
    "//#infra:stop": {
      "cache": false
    },
    "//#infra:destroy": {
      "cache": false
    },
    "db:drizzle-pull": {
      "cache": false
    },
    "db:generate-schema": {
      "cache": false
    },
    "db:schema-normalize": {
      "cache": false
    }
  }
}
