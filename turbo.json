{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate-openapi", "db:migrate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "generate-openapi": {
      "outputs": ["openapi/openapi.yaml"]
    },
    "lint": {},
    "lint:autofix": {},
    "db:generate": {
      "outputs": ["drizzle/**"]
    },
    "db:migrate": {}
  }
}
