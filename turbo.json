{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate-openapi", "generate-protobuf"]
    },
    "typecheck": {
      "dependsOn": ["generate-protobuf", "^typecheck"]
    },
    "generate-openapi": {},
    "generate-protobuf": {
      "outputs": ["src/generated"]
    },
    "lint": {},
    "lint:autofix": {},
    "build-knip-dependencies": {
      "dependsOn": ["generate-protobuf"]
    }
  }
}
