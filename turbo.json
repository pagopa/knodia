{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["generate-api-client", "generate-openapi"]
    },
    "typecheck": {
      "dependsOn": ["generate-api-client", "^typecheck"]
    },
    "generate-api-client": {
      "outputs": ["generated/**"]
    },
    "generate-openapi": {},
    "lint": {},
    "lint:autofix": {},
    "build-knip-dependencies": {
      "dependsOn": ["generate-openapi"]
    }
  }
}
