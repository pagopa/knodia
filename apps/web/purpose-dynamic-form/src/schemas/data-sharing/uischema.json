{
  "type": "Group",
  "elements": [
    {
      "type": "Group",
      "textKey": "agreementDetails",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/agreementType",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/customDescription",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/agreementType",
              "schema": { "const": "CUSTOM" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dataCategories",
          "options": {
            "widget": "checkbox",
            "hideOptions": {
              "HEALTH": {
                "scope": "#/properties/sharingScope",
                "schema": { "const": "EXTERNAL" }
              }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/otherDataCategories",
          "options": {
            "widget": "text"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/dataCategories",
              "schema": { "contains": { "const": "OTHER" } }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/sharingScope",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Label",
          "textKey": "externalSharingWarning",
          "options": { "variant": "warning" },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/sharingScope",
              "schema": { "const": "EXTERNAL" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/externalParties",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "HIDE",
            "condition": {
              "scope": "#/properties/sharingScope",
              "schema": { "const": "INTERNAL" }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "textKey": "complianceAndSecurity",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/retentionPeriod",
          "options": {
            "widget": "select"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/retentionJustification",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/retentionPeriod",
              "schema": { "const": "INDEFINITE" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/encryptionRequired",
          "options": {
            "widget": "switch"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/encryptionMethod",
          "options": {
            "widget": "radio"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/encryptionRequired",
              "schema": { "const": "true" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/otherEncryptionMethod",
          "options": {
            "widget": "text"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "type": "AND",
              "conditions": [
                {
                  "scope": "#/properties/encryptionRequired",
                  "schema": { "const": "true" }
                },
                {
                  "scope": "#/properties/encryptionMethod",
                  "schema": { "const": "OTHER" }
                }
              ]
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/consentStatus",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/consentReference",
          "options": {
            "widget": "text"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/consentStatus",
              "schema": { "const": "OBTAINED" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/noConsentReason",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/consentStatus",
              "schema": { "const": "NOT_OBTAINED" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dpoNotified",
          "options": {
            "widget": "switch"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/additionalNotes",
          "options": {
            "widget": "textarea"
          }
        }
      ]
    }
  ]
}
