{
  "type": "Group",
  "elements": [
    {
      "type": "Group",
      "label": "Agreement details",
      "options": {
        "description": "Define the type and scope of the data sharing agreement."
      },
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/agreementType",
          "label": "Agreement type",
          "options": {
            "widget": "radio",
            "layout": "horizontal",
            "optionLabels": {
              "STANDARD": "Standard agreement",
              "CUSTOM": "Custom agreement"
            },
            "errorMessages": {
              "required": "Select an agreement type"
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/customDescription",
          "label": "Custom agreement description",
          "options": {
            "widget": "textarea",
            "infoLabel": "Describe the specific terms that differ from the standard agreement.",
            "errorMessages": {
              "required": "Provide a description for the custom agreement"
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/agreementType",
              "schema": { "const": "CUSTOM" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dataCategories",
          "label": "Data categories",
          "options": {
            "widget": "checkbox",
            "layout": "vertical",
            "optionLabels": {
              "FINANCIAL": "Financial data",
              "HEALTH": "Health data",
              "BEHAVIORAL": "Behavioral data",
              "CONTACT": "Contact information",
              "OTHER": "Other"
            },
            "hideOptions": {
              "HEALTH": {
                "scope": "#/properties/sharingScope",
                "schema": { "const": "EXTERNAL" }
              }
            },
            "errorMessages": {
              "required": "Select at least one data category"
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/otherDataCategories",
          "label": "Other data categories",
          "options": {
            "widget": "text",
            "errorMessages": {
              "required": "Specify the other data categories"
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/dataCategories",
              "schema": { "contains": { "const": "OTHER" } }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/sharingScope",
          "label": "Sharing scope",
          "options": {
            "widget": "radio",
            "layout": "horizontal",
            "optionLabels": {
              "INTERNAL": "Internal only",
              "EXTERNAL": "External parties",
              "BOTH": "Internal and external"
            },
            "errorMessages": {
              "required": "Select a sharing scope"
            }
          }
        },
        {
          "type": "Label",
          "text": "External sharing requires additional compliance review. Contact the DPO before proceeding.",
          "options": { "variant": "warning" },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/sharingScope",
              "schema": { "const": "EXTERNAL" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/externalParties",
          "label": "External parties",
          "options": {
            "widget": "textarea",
            "infoLabel": "List all external parties that will receive the shared data.",
            "errorMessages": {
              "required": "List the external parties involved"
            }
          },
          "rule": {
            "effect": "HIDE",
            "condition": {
              "scope": "#/properties/sharingScope",
              "schema": { "const": "INTERNAL" }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "label": "Compliance and security",
      "options": {
        "description": "Specify retention, encryption, and consent details."
      },
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/retentionPeriod",
          "label": "Data retention period",
          "options": {
            "widget": "select",
            "optionLabels": {
              "6_MONTHS": "6 months",
              "1_YEAR": "1 year",
              "3_YEARS": "3 years",
              "5_YEARS": "5 years",
              "INDEFINITE": "Indefinite"
            },
            "errorMessages": {
              "required": "Select a retention period"
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/retentionJustification",
          "label": "Justification for indefinite retention",
          "options": {
            "widget": "textarea",
            "errorMessages": {
              "required": "Provide a justification for indefinite retention"
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/retentionPeriod",
              "schema": { "const": "INDEFINITE" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/encryptionRequired",
          "label": "Encryption required",
          "options": {
            "widget": "switch",
            "description": "Enable if data must be encrypted in transit and at rest.",
            "optionLabels": {
              "true": "Encryption is required for this agreement"
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/encryptionMethod",
          "label": "Encryption method",
          "options": {
            "widget": "radio",
            "layout": "horizontal",
            "optionLabels": {
              "AES_256": "AES-256",
              "RSA": "RSA",
              "TLS": "TLS",
              "OTHER": "Other"
            },
            "errorMessages": {
              "required": "Select an encryption method"
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/encryptionRequired",
              "schema": { "const": "true" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/otherEncryptionMethod",
          "label": "Other encryption method",
          "options": {
            "widget": "text",
            "errorMessages": {
              "required": "Specify the encryption method"
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "type": "AND",
              "conditions": [
                {
                  "scope": "#/properties/encryptionRequired",
                  "schema": { "const": "true" }
                },
                {
                  "scope": "#/properties/encryptionMethod",
                  "schema": { "const": "OTHER" }
                }
              ]
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/consentStatus",
          "label": "Consent status",
          "options": {
            "widget": "radio",
            "layout": "vertical",
            "optionLabels": {
              "OBTAINED": "Consent obtained",
              "NOT_OBTAINED": "Consent not yet obtained",
              "NOT_APPLICABLE": "Not applicable"
            },
            "errorMessages": {
              "required": "Select the consent status"
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/consentReference",
          "label": "Consent reference",
          "options": {
            "widget": "text",
            "infoLabel": "Provide a reference number or document identifier for the obtained consent.",
            "errorMessages": {
              "required": "Provide the consent reference"
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/consentStatus",
              "schema": { "const": "OBTAINED" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/noConsentReason",
          "label": "Reason consent not obtained",
          "options": {
            "widget": "textarea",
            "errorMessages": {
              "required": "Explain why consent has not been obtained"
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/consentStatus",
              "schema": { "const": "NOT_OBTAINED" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dpoNotified",
          "label": "DPO notification",
          "options": {
            "widget": "switch",
            "description": "Confirm the Data Protection Officer has been notified.",
            "optionLabels": {
              "true": "DPO has been notified"
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/additionalNotes",
          "label": "Additional notes",
          "options": {
            "widget": "textarea",
            "infoLabel": "Any additional information relevant to this data sharing agreement."
          }
        }
      ]
    }
  ]
}
