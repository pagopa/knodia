{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Group",
      "textKey": "purposeAndDataTypes",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/purpose",
          "label": "Purpose of access",
          "options": {
            "widget": "select"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/purposeDescription",
          "options": {
            "widget": "textarea"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/personalDataTypes",
          "options": {
            "widget": "checkbox"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/otherPersonalDataTypes",
          "options": {
            "widget": "text"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/personalDataTypes",
              "schema": { "contains": { "const": "OTHER" } }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/usesThirdPartyPersonalData",
          "label": "Accessing data on behalf of third parties?",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/thirdPartiesRequestDataUsage",
          "label": "On behalf of entity under Section 2(2)(a) CAD?",
          "options": {
            "widget": "select"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/usesThirdPartyPersonalData",
              "schema": { "const": "YES" }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "textKey": "legalBasisGroup",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/legalBasis",
          "label": "Legal basis for processing",
          "options": {
            "widget": "checkbox"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/legalObligationReference",
          "label": "Relevant legal obligation",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/legalBasis",
              "schema": { "contains": { "const": "LEGAL_OBLIGATION" } }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/publicInterestReasons",
          "label": "Public interest reasons",
          "options": {
            "widget": "checkbox"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/legalBasis",
              "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/legalBasisPublicInterest",
          "label": "Public interest legal basis type",
          "options": {
            "widget": "select",
            "hideOptions": {
              "PUBLIC_INTEREST_TASK": {
                "scope": "#/properties/personalDataTypes",
                "schema": { "contains": { "const": "GDPR_ART_9" } }
              }
            }
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/legalBasis",
              "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/ruleOfLawText",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "type": "AND",
              "conditions": [
                {
                  "scope": "#/properties/legalBasisPublicInterest",
                  "schema": { "const": "RULE_OF_LAW" }
                },
                {
                  "scope": "#/properties/legalBasis",
                  "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
                }
              ]
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/administrativeActText",
          "label": "Applicable administrative act",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "type": "AND",
              "conditions": [
                {
                  "scope": "#/properties/legalBasisPublicInterest",
                  "schema": { "const": "ADMINISTRATIVE_ACT" }
                },
                {
                  "scope": "#/properties/legalBasis",
                  "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
                }
              ]
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/publicInterestTaskText",
          "label": "Public-interest task reference",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/legalBasisPublicInterest",
              "schema": { "const": "PUBLIC_INTEREST_TASK" }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "textKey": "deliveryAndQuantity",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/deliveryMethod",
          "label": "Data delivery format",
          "options": {
            "widget": "select"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/knowsDataQuantity",
          "label": "Data quantity known?",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dataQuantity",
          "label": "Quantity range",
          "options": {
            "widget": "select"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/knowsDataQuantity",
              "schema": { "const": "YES" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dataDownload",
          "label": "Data download allowed?",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dataRetentionPeriod",
          "label": "Retention period",
          "options": {
            "widget": "text"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/dataDownload",
              "schema": { "const": "YES" }
            }
          }
        }
      ]
    },
    {
      "type": "Group",
      "textKey": "privacySecurityAndCompliance",
      "elements": [
        {
          "type": "Control",
          "scope": "#/properties/policyProvided",
          "label": "Privacy notice provided?",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/reasonPolicyNotProvided",
          "label": "Reason for not providing notice",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/policyProvided",
              "schema": { "const": "NO" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/policyProvidedMedium",
          "label": "Notice delivery medium",
          "options": {
            "widget": "select"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/policyProvided",
              "schema": { "const": "YES" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/policyProvidedOnlineLink",
          "label": "Privacy notice URL",
          "options": {
            "widget": "text"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "type": "AND",
              "conditions": [
                {
                  "scope": "#/properties/policyProvided",
                  "schema": { "const": "YES" }
                },
                {
                  "scope": "#/properties/policyProvidedMedium",
                  "schema": { "const": "ONLINE" }
                }
              ]
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
          "label": "Security measures adopted (Art. 5(1)(f) GDPR)",
          "options": {
            "widget": "switch"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/dataProtectionMeasures",
          "label": "Technical and organizational measures",
          "options": {
            "widget": "textarea"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "type": "AND",
              "conditions": [
                {
                  "scope": "#/properties/personalDataTypes",
                  "schema": { "contains": { "const": "GDPR_ART_10" } }
                },
                {
                  "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
                  "schema": { "const": "true" }
                }
              ]
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/doneDpia",
          "label": "DPIA carried out?",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Label",
          "textKey": "dpiaReminder",
          "options": { "variant": "info" },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/doneDpia",
              "schema": { "const": "NO" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/confirmedDoneDpia",
          "label": "Prior consultation carried out?",
          "options": {
            "widget": "radio"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/doneDpia",
              "schema": { "const": "YES" }
            }
          }
        },
        {
          "type": "Label",
          "textKey": "priorConsultationReminder",
          "options": { "variant": "info" },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/confirmedDoneDpia",
              "schema": { "const": "NO" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/purposePursuit",
          "label": "Data minimization",
          "options": {
            "widget": "radio"
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/checkedExistenceMereCorrectnessInteropCatalogue",
          "label": "API Catalogue check performed",
          "options": {
            "widget": "switch"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/purposePursuit",
              "schema": { "const": "MERE_CORRECTNESS" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/checkedAllDataNeeded",
          "label": "Data necessity check",
          "options": {
            "widget": "switch"
          },
          "rule": {
            "effect": "SHOW",
            "condition": {
              "scope": "#/properties/purposePursuit",
              "schema": { "const": "NEW_PERSONAL_DATA" }
            }
          }
        },
        {
          "type": "Control",
          "scope": "#/properties/declarationConfirmGDPR",
          "label": "GDPR compliance declaration (Art. 5(2))",
          "options": {
            "widget": "switch"
          }
        }
      ]
    }
  ]
}
