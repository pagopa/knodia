{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/purpose",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/purposeDescription",
      "options": {
        "widget": "textarea"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/personalDataTypes",
      "options": {
        "widget": "checkbox"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/otherPersonalDataTypes",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/personalDataTypes",
          "schema": { "contains": { "const": "OTHER" } }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/legalBasis",
      "options": {
        "widget": "checkbox"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/legalObligationReference",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/legalBasis",
          "schema": { "contains": { "const": "LEGAL_OBLIGATION" } }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/publicInterestReasons",
      "options": {
        "widget": "checkbox"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/legalBasis",
          "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/legalBasisPublicInterest",
      "options": {
        "widget": "radio",
        "hideOptions": {
          "PUBLIC_INTEREST_TASK": {
            "scope": "#/properties/personalDataTypes",
            "schema": { "contains": { "const": "GDPR_ART_9" } }
          }
        }
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/legalBasis",
          "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/ruleOfLawText",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "type": "AND",
          "conditions": [
            {
              "scope": "#/properties/legalBasisPublicInterest",
              "schema": { "const": "RULE_OF_LAW" }
            },
            {
              "scope": "#/properties/legalBasis",
              "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
            }
          ]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/administrativeActText",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "type": "AND",
          "conditions": [
            {
              "scope": "#/properties/legalBasisPublicInterest",
              "schema": { "const": "ADMINISTRATIVE_ACT" }
            },
            {
              "scope": "#/properties/legalBasis",
              "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
            }
          ]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/publicInterestTaskText",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/legalBasisPublicInterest",
          "schema": { "const": "PUBLIC_INTEREST_TASK" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/knowsDataQuantity",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/dataQuantity",
      "options": {
        "widget": "radio"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/knowsDataQuantity",
          "schema": { "const": "YES" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/deliveryMethod",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/policyProvided",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/reasonPolicyNotProvided",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/policyProvided",
          "schema": { "const": "NO" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/policyProvidedMedium",
      "options": {
        "widget": "radio"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/policyProvided",
          "schema": { "const": "YES" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/policyProvidedOnlineLink",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "type": "AND",
          "conditions": [
            {
              "scope": "#/properties/policyProvided",
              "schema": { "const": "YES" }
            },
            {
              "scope": "#/properties/policyProvidedMedium",
              "schema": { "const": "ONLINE" }
            }
          ]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
      "options": {
        "widget": "switch"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/dataProtectionMeasures",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "type": "AND",
          "conditions": [
            {
              "scope": "#/properties/personalDataTypes",
              "schema": { "contains": { "const": "GDPR_ART_10" } }
            },
            {
              "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
              "schema": { "const": "true" }
            }
          ]
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/doneDpia",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Label",
      "textKey": "dpiaReminder",
      "options": { "variant": "info" },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/doneDpia",
          "schema": { "const": "NO" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/confirmedDoneDpia",
      "options": {
        "widget": "radio"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/doneDpia",
          "schema": { "const": "YES" }
        }
      }
    },
    {
      "type": "Label",
      "textKey": "priorConsultationReminder",
      "options": { "variant": "info" },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/confirmedDoneDpia",
          "schema": { "const": "NO" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/dataDownload",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/dataRetentionPeriod",
      "options": {
        "widget": "textarea"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/dataDownload",
          "schema": { "const": "YES" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/purposePursuit",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/checkedExistenceMereCorrectnessInteropCatalogue",
      "options": {
        "widget": "switch"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/purposePursuit",
          "schema": { "const": "MERE_CORRECTNESS" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/checkedAllDataNeeded",
      "options": {
        "widget": "switch"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/purposePursuit",
          "schema": { "const": "NEW_PERSONAL_DATA" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/usesThirdPartyPersonalData",
      "options": {
        "widget": "radio"
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/thirdPartiesRequestDataUsage",
      "options": {
        "widget": "radio"
      },
      "rule": {
        "effect": "SHOW",
        "condition": {
          "scope": "#/properties/usesThirdPartyPersonalData",
          "schema": { "const": "YES" }
        }
      }
    },
    {
      "type": "Control",
      "scope": "#/properties/declarationConfirmGDPR",
      "options": {
        "widget": "switch"
      }
    }
  ]
}
