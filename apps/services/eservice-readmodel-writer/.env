LOG_LEVEL=info

READMODEL_DB_USER=local_eservice_rmw_user
READMODEL_DB_PASSWORD=local_eservice_rmw_user
READMODEL_DB_HOST=localhost
READMODEL_DB_PORT=5432
READMODEL_DB_NAME=readmodel
READMODEL_DB_USE_SSL=false

READMODEL_DB_ESERVICE_SCHEMA=local_eservice

KAFKA_BROKERS=localhost:29092
KAFKA_LOG_LEVEL=INFO
KAFKA_CLIENT_ID=kafka-eservice-client
KAFKA_GROUP_ID=kafka-eservice-readmodel-writer
TOPIC_STARTING_OFFSET=latest
KAFKA_DISABLE_AWS_IAM_AUTH=true

ESERVICE_TOPIC=event-store.local_eservice.events

AWS_REGION=eu-south-1
