LOG_LEVEL=info

READMODEL_DB_USER=local_keychain_rmw_user
READMODEL_DB_PASSWORD=local_keychain_rmw_user
READMODEL_DB_HOST=localhost
READMODEL_DB_PORT=5432
READMODEL_DB_NAME=readmodel
READMODEL_DB_USE_SSL=false

READMODEL_DB_KEYCHAIN_SCHEMA=local_keychain

KAFKA_BROKERS=localhost:29092
KAFKA_LOG_LEVEL=INFO
KAFKA_CLIENT_ID=kafka-keychain-client
KAFKA_DISABLE_AWS_IAM_AUTH=true

KAFKA_GROUP_ID=kafka-keychain-readmodel-writer
TOPIC_STARTING_OFFSET=latest

KEYCHAIN_TOPIC=event-store.local_keychain.events
