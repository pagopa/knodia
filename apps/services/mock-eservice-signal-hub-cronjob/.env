LOG_LEVEL=debug

# Shared with mock-eservice — both must agree on these so that the periodId
# the cron emits for matches the seed the producer hands out.
SEED_START_DATE_MS=1767225600000
SEED_EXPIRE_SECONDS=30
SEED_SALT_LENGTH=16

SIGNAL_HUB_DB_HOST=localhost
SIGNAL_HUB_DB_PORT=5432
SIGNAL_HUB_DB_NAME=signal_hub
SIGNAL_HUB_DB_SCHEMA=local_signal_hub
SIGNAL_HUB_DB_USER=local_signal_hub_cron_user
SIGNAL_HUB_DB_PASSWORD=local_signal_hub_cron_user
SIGNAL_HUB_DB_USE_SSL=false
