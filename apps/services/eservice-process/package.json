{
  "name": "@knodia/eservice-process",
  "type": "module",
  "scripts": {
    "start": "dotenvx run -- node --watch ./src/index.ts",
    "typecheck:watch": "tsc --watch --pretty",
    "dev": "concurrently -n tsc,run -c auto -k 'pnpm run typecheck:watch' 'pnpm run start'",
    "typecheck": "tsc",
    "generate-openapi": "dotenvx run -- node ./openapi/generateOpenapi.ts",
    "lint": "eslint .",
    "lint:autofix": "eslint . --fix",
    "lint-openapi": "spectral lint --fail-severity='warn' ./openapi/openapi.yaml --ruleset=./spectral.yaml"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "catalog:",
    "@knodia/db-event-store-eservice": "workspace:*",
    "@knodia/eslint-config": "workspace:*",
    "@knodia/spectral-config": "workspace:*",
    "@knodia/test-commons": "workspace:*",
    "@knodia/typescript-config": "workspace:*",
    "@stoplight/spectral-cli": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zocker": "catalog:"
  },
  "dependencies": {
    "@fastify/request-context": "catalog:",
    "@knodia/attribute-models": "workspace:*",
    "@knodia/category-models": "workspace:*",
    "@knodia/common-models": "workspace:*",
    "@knodia/db-event-store-commons": "workspace:*",
    "@knodia/db-event-store-eservice": "workspace:*",
    "@knodia/db-event-store-writer": "workspace:*",
    "@knodia/db-readmodel-commons": "workspace:*",
    "@knodia/db-readmodel-eservice": "workspace:*",
    "@knodia/db-readmodel-organization": "workspace:*",
    "@knodia/eservice-models": "workspace:*",
    "@knodia/eservice-template-models": "workspace:*",
    "@knodia/fastify-zod-api-commons": "workspace:*",
    "@knodia/logger": "workspace:*",
    "@knodia/purpose-models": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "pino-pretty": "catalog:",
    "zod": "catalog:"
  }
}
