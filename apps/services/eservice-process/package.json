{
  "name": "@knodia/eservice-process",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n tsc,run -c auto -k 'tsc --watch --pretty' 'node --watch ./src/index.ts'",
    "typecheck": "tsc",
    "build": "tsc --build ./tsconfig.build.json",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:autofix": "eslint . --ext .ts,.tsx --fix"
  },
  "devDependencies": {
    "@knodia/eslint-config": "workspace:*",
    "@knodia/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
