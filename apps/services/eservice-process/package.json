{
  "name": "@knodia/eservice-process",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n tsc,run -c auto -k 'tsc --watch --pretty' 'node --watch ./src/index.ts'",
    "typecheck": "tsc",
    "build": "tsc --build ./tsconfig.build.json",
    "generate-openapi": "node ./generateOpenApi.js"
  },
  "devDependencies": {
    "@knodia/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@fastify/swagger": "catalog:",
    "@fastify/swagger-ui": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "zod": "catalog:"
  }
}
