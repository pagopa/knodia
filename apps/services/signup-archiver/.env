LOG_LEVEL=info

KAFKA_BROKERS=localhost:29092
KAFKA_LOG_LEVEL=INFO
KAFKA_CLIENT_ID=kafka-signup-archiver-client
KAFKA_DISABLE_AWS_IAM_AUTH=true

KAFKA_GROUP_ID=kafka-signup-archiver
TOPIC_STARTING_OFFSET=latest

SIGNUP_TOPIC=signup.events

AWS_CONFIG_FILE=aws.config.local
SIGNUP_ARCHIVES_S3_BUCKET=knodia-signup-archives

SIGNUP_DB_HOST=localhost
SIGNUP_DB_PORT=5432
SIGNUP_DB_NAME=signup
SIGNUP_DB_SCHEMA=local_signup
SIGNUP_DB_USER=local_signup_archiver_user
SIGNUP_DB_PASSWORD=local_signup_archiver_user
SIGNUP_DB_USE_SSL=false
