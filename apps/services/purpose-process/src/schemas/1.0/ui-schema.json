{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Group",
      "label": "Lawfulness of processing",
      "options": {
        "description": "Declare the lawfulness of your request to access the data provided by this E-Service."
      },
      "elements": [
        {
          "type": "Group",
          "label": "What is the purpose of your access to the data provided by this E-Service?",
          "options": {
            "description": "NB: Under Art. 5(1)(b) of the GDPR (purpose limitation principle), your purposes must be specific, explicit, and legitimate. Any data obtained may only be processed in ways that are compatible with those stated purposes. If you have more than one purpose, you MUST complete a separate declaration for each one."
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/purpose",
              "label": "Purpose of data access",
              "options": {
                "widget": "radio",
                "optionLabels": {
                  "INSTITUTIONAL": "For institutional purposes that do not require additional processing",
                  "OTHER": "Other"
                },
                "errorMessages": {
                  "required": "Please select a purpose"
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/institutionalPurpose",
              "label": "Describe your purpose",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please specify the institutional purpose",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/purpose",
                  "schema": { "const": "INSTITUTIONAL" }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/otherPurpose",
              "label": "Describe your purpose",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please specify the purpose",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/purpose",
                  "schema": { "const": "OTHER" }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Do you access personal data?",
          "options": {
            "description": "NB: Under Art. 4(1)(1) of the GDPR, personal data means any information about an identified or identifiable person, directly or indirectly, by reference to an identifier (e.g., a name, identification number, location data, online identifier) or one or more factors specific to their physical, physiological, genetic, mental, economic, cultural, or social identity. Therefore, personal data includes not only data that directly identifies an individual but also data that can be linked to an individual only indirectly through third parties (e.g., vehicle license plate number, employee number, or other alphanumeric code assigned by a third party)."
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/usesPersonalData",
              "label": "Personal data access",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/usesThirdPartyNonPersonalData",
              "label": "Do you access non-personal data belonging to third parties (i.e. non-personal data that does not pertain to you as Consumer)?",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "NO" }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/usesThirdPartyConfidentialData",
              "label": "Do you access non-personal data that is nonetheless confidential or strictly reserved?",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "NO" }
                    },
                    {
                      "scope": "#/properties/usesThirdPartyNonPersonalData",
                      "schema": { "const": "YES" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Select the type(s) of personal data you will access through this E-Service, based on the definitions in Art. 4(1), (13), (14), and (15) of the GDPR.",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/personalDataTypes",
              "label": "Type(s) of personal data",
              "options": {
                "widget": "checkbox",
                "optionLabels": {
                  "WITH_NON_IDENTIFYING_DATA": "Common non-identifying personal data (e.g., license plate number)",
                  "WITH_IDENTIFYING_DATA": "Common personal identification data (e.g., tax code)",
                  "GDPR_ART_8": "Data relating to minors under Art. 8 of the GDPR (e.g., a minor's name and surname)",
                  "GDPR_ART_9": "Special categories of data under Art. 9 of the GDPR (e.g., racial or ethnic origin, political opinions, religious or philosophical beliefs, trade union membership, genetic data, biometric data used to uniquely identify a person, health data, or data about sex life or sexual orientation)",
                  "GDPR_ART_10": "Criminal-related data under Art. 10 of the GDPR",
                  "OTHER": "Other"
                },
                "errorMessages": {
                  "required": "Please select at least one type of personal data"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/otherPersonalDataTypes",
              "label": "Specify the type of personal data",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please specify the type of personal data",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/personalDataTypes",
                      "schema": { "contains": { "const": "OTHER" } }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Under which legal basis (Art. 6 of the GDPR) do you believe you are entitled to access the personal data provided by this E-Service?",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/legalBasis",
              "label": "Legal basis to access personal data",
              "options": {
                "widget": "checkbox",
                "optionLabels": {
                  "CONSENT": "Consent of the data subject to the processing of personal data for one or more specific purposes",
                  "CONTRACT": "Performance of a contract to which the data subject is party or of pre-contractual measures adopted at the request of the data subject",
                  "LEGAL_OBLIGATION": "Compliance with a legal obligation",
                  "SAFEGUARD": "Safeguarding the vital interests of a natural person",
                  "PUBLIC_INTEREST": "Performance of a task in the public interest or in the exercise of official authority vested in you"
                },
                "errorMessages": {
                  "required": "Please select at least one legal basis"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/legalObligationReference",
              "label": "Specify the legal obligation and, where possible, the relevant legislation",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please specify the legal obligation",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": { "contains": { "const": "LEGAL_OBLIGATION" } }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "GDPR compliance declaration",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/declarationConfirmGDPR",
              "options": {
                "widget": "switch",
                "optionLabels": { "true": "I declare that I am aware of the GDPR obligations regarding personal data processing and that I am able to demonstrate compliance (accountability principle under Article 5(2) of the GDPR)." },
                "errorMessages": { "required": "Confirmation required" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "label": "Risk analysis",
      "options": {
        "description": "Complete the questionnaire to assess the risks associated with accessing the data provided by this E-Service."
      },
      "elements": [
        {
          "type": "Group",
          "label": "Enter the reasons for carrying out a task of public interest or connected to the exercise of public authority with which you are invested",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/legalBasisPublicInterest",
              "label": "Public-interest legal basis",
              "options": {
                "widget": "radio",
                "optionLabels": {
                  "RULE_OF_LAW": "Law or regulation under Section 2-ter(1) of the Italian Privacy Code (for common personal data) and Section 2-sexies(1) of the Italian Privacy Code (for special categories of data)",
                  "ADMINISTRATIVE_ACT": "General administrative act under Section 2-ter(1) of the Italian Privacy Code (for common personal data) and Section 2-sexies(1) of the Italian Privacy Code (for special categories of data)",
                  "PUBLIC_INTEREST_TASK": "Performance of a public-interest task or exercise of public powers conferred to you under Section 2-ter(1 bis) of the Italian Privacy Code"
                },
                "hideOptions": {
                  "PUBLIC_INTEREST_TASK": {
                    "scope": "#/properties/personalDataTypes",
                    "schema": {
                      "contains": { "const": "GDPR_ART_9" }
                    }
                  }
                },
                "errorMessages": {
                  "required": "Please select an option"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/ruleOfLawText",
              "label": "Applicable law or regulation under Section 2-ter(1) of the Italian Privacy Code (for common personal data) and Section 2-sexies(1) of the Italian Privacy Code (for special categories of data).",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please enter the applicable law or regulation",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/legalBasisPublicInterest",
                      "schema": { "const": "RULE_OF_LAW" }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/administrativeActText",
              "label": "Applicable general administrative act under Section 2-ter(1) of the Italian Privacy Code (for common personal data) and Section 2-sexies(1) of the Italian Privacy Code (for special categories of data).",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please enter the applicable general administrative act",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/legalBasisPublicInterest",
                      "schema": { "const": "ADMINISTRATIVE_ACT" }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/publicInterestTaskText",
              "label": "Reference to the public-interest task or the exercise of public powers attributed to you under Section 2-ter(1 bis) of the Italian Privacy Code.",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please enter the task performed or public reference",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/legalBasisPublicInterest",
                      "schema": { "const": "PUBLIC_INTEREST_TASK" }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": { "contains": { "const": "PUBLIC_INTEREST" } }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Amount of personal data",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/knowsDataQuantity",
              "label": "Do you know the amount of personal data you will obtain through the use of this E-Service?",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/dataQuantity",
              "label": "Reference range, to be selected considering the validity period of the voucher issued for this E-Service",
              "options": {
                "widget": "radio",
                "optionLabels": {
                  "QUANTITY_0_TO_100": "0-100",
                  "QUANTITY_101_TO_500": "101-500",
                  "QUANTITY_500_TO_1000": "501-1000",
                  "QUANTITY_1001_TO_5000": "1001-5000",
                  "QUANTITY_5001_OVER": "5001 or more"
                },
                "errorMessages": { "required": "Please select a range" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/knowsDataQuantity",
                      "schema": { "const": "YES" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "How do you intend to receive the information from the Producer?",
          "options": {
            "description": "NB: Under Article 5(1)(c) of the GDPR (data minimization principle), personal data processing must be proportionate and limited to what is strictly necessary for your stated purpose. Only adequate, relevant, and necessary data may be accessed via the e-service.\n\nTherefore:\n(i) you may select \"clear\" or \"pseudonymized\" data only if aggregated or anonymous data are insufficient for the purposes stated in point 1;\n(ii) you may select \"clear\" data only if pseudonymized data are also insufficient."
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/deliveryMethod",
              "label": "Delivery method",
              "options": {
                "widget": "radio",
                "optionLabels": {
                  "ANONYMOUS": "In anonymized form",
                  "AGGREGATE": "In aggregate form",
                  "PSEUDOANONYMOUS": "In pseudonymized form",
                  "CLEARTEXT": "Clear (unencrypted) data"
                },
                "errorMessages": {
                  "required": "Please select a delivery method"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Privacy notice",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/policyProvided",
              "label": "Has a privacy notice been provided to the data subject regarding the data you intend to access or receive through this E-Service and the related processing activities you will carry out?",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/reasonPolicyNotProvided",
              "label": "Explain why a specific privacy notice was not provided, in accordance with Article 14(5) of the GDPR",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please explain why a privacy notice was not provided",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/policyProvided",
                      "schema": { "const": "NO" }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/policyProvidedMedium",
              "label": "How was the privacy notice provided?",
              "options": {
                "widget": "radio",
                "optionLabels": { "PRINT": "Print", "ONLINE": "Online" },
                "errorMessages": { "required": "Please select a medium" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/policyProvided",
                      "schema": { "const": "YES" }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/policyProvidedOnlineLink",
              "label": "Enter the link to the privacy notice",
              "options": {
                "widget": "text",
                "errorMessages": {
                  "required": "Please enter the link to the privacy notice",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/policyProvided",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/policyProvidedMedium",
                      "schema": { "const": "ONLINE" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Integrity and confidentiality principle",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
              "options": {
                "widget": "switch",
                "optionLabels": { "true": "I confirm that — in line with the integrity and confidentiality principle under Article 5(1)(f) of the GDPR — I have adopted all necessary technical and organizational measures to ensure adequate security of the personal data accessed through this E-Service, including protection against unauthorized or unlawful processing and against accidental loss, destruction, or damage." },
                "errorMessages": { "required": "Confirmation required" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Personal data protection measures",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/dataProtectionMeasures",
              "label": "Describe the technical and organizational measures adopted to ensure adequate security of personal data under Articles 25 and 32 of the GDPR",
              "options": {
                "widget": "textarea",
                "errorMessages": {
                  "required": "Please describe the measures adopted",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/personalDataTypes",
                      "schema": { "contains": { "const": "GDPR_ART_10" } }
                    },
                    {
                      "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
                      "schema": { "const": "true" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Data Protection Impact Assessment (DPIA)",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/doneDpia",
              "label": "Has a Data Protection Impact Assessment (DPIA) been carried out for the personal data processing activities that will be performed through this E-Service?",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            },
            {
              "type": "Label",
              "text": "Remember that the impact assessment is mandatory if the conditions set out in Section 35 of the GDPR exist.",
              "options": { "variant": "info" },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/doneDpia",
                      "schema": { "const": "NO" }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/doneDpaPriorConsultation",
              "label": "Has a prior consultation with the Data Protection Authority been carried out?",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/doneDpia",
                      "schema": { "const": "YES" }
                    }
                  ]
                }
              }
            },
            {
              "type": "Label",
              "text": "Remember that prior consultation is mandatory if the conditions set out in Section 36 of the GDPR exist.",
              "options": { "variant": "info" },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/doneDpaPriorConsultation",
                      "schema": { "const": "NO" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Does this E-Service allow data downloads?",
          "options": {
            "description": "NB: Downloaded data may not be up to date, which conflicts with the data accuracy principle under Article 5(1)(d) of the GDPR. Please limit downloads to cases where they are strictly necessary and justified by the processing purpose.\n\nAlso note that under Article 5(1)(b) and (e) of the GDPR (purpose limitation and storage limitation), data may only be kept for the time strictly necessary to achieve the specific, explicit, and legitimate purposes for which they were collected."
          },
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/dataDownload",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/dataRetentionPeriod",
              "label": "Specify the data retention period you have identified (e.g., 1 hour, 10 days, 3 months, or 2 years)",
              "options": {
                "widget": "text",
                "errorMessages": {
                  "required": "Please enter the retention period",
                  "maxLength": "Must not exceed 2000 characters"
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/dataDownload",
                      "schema": { "const": "YES" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Data minimization principle",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/purposePursuit",
              "label": "Under the data minimization principle (Article 5(1)(c) of the GDPR), to achieve the stated purpose, please indicate whether:",
              "options": {
                "widget": "radio",
                "optionLabels": {
                  "MERE_CORRECTNESS": "It is sufficient for the Producer to verify the mere correctness of a specific piece of information/personal data already in its possession",
                  "NEW_PERSONAL_DATA": "It is necessary to receive a certain personal data again"
                },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": { "const": "YES" }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Catalogue check",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/checkedExistenceMereCorrectnessInteropCatalogue",
              "options": {
                "widget": "switch",
                "optionLabels": { "true": "I confirm that I have checked whether another E-Service in the API Catalogue can perform this verification without requiring new personal data to be shared." },
                "errorMessages": { "required": "Confirmation required" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/purposePursuit",
                      "schema": { "const": "MERE_CORRECTNESS" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Needed data check",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/checkedAllDataNeeded",
              "options": {
                "widget": "switch",
                "description": "NB: If you only need some of the personal data provided by this E-Service, check whether a more limited one already exists. If not, ask a Producer to set one up.",
                "optionLabels": { "true": "I confirm that I have verified whether all the personal data provided through this E-Service are actually needed." },
                "errorMessages": { "required": "Confirmation required" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": { "const": "YES" }
                    },
                    {
                      "scope": "#/properties/purposePursuit",
                      "schema": { "const": "NEW_PERSONAL_DATA" }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "label": "Third-party data",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/isRequestOnBehalfOfThirdParties",
              "label": "Are you accessing data on behalf of or at the request of third parties?",
              "options": {
                "widget": "radio",
                "optionLabels": { "YES": "Yes", "NO": "No" },
                "errorMessages": { "required": "Please select an option" }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/thirdPartiesRequestDataUsage",
              "label": "Do you intend to use this E-Service to access data:",
              "options": {
                "widget": "radio",
                "optionLabels": {
                  "PA_ONLY": "Exclusively on behalf of an entity referred to in Art. 2(2)(a) of the Digital Administration Code (CAD)",
                  "PA_ALSO": "Also on behalf of an entity referred to in Art. 2(2)(a) of the Digital Administration Code (CAD)"
                },
                "errorMessages": { "required": "Please select an option" }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/isRequestOnBehalfOfThirdParties",
                  "schema": { "const": "YES" }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
