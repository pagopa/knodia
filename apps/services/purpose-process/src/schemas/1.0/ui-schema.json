{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Group",
      "i18n": "groups.lawfulnessOfProcessing",
      "elements": [
        {
          "type": "Group",
          "i18n": "groups.purposeOfAccess",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/purpose",
              "options": {
                "widget": "radio"
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/institutionalPurpose",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/purpose",
                  "schema": {
                    "const": "INSTITUTIONAL"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/otherPurpose",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/purpose",
                  "schema": {
                    "const": "OTHER"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.personalDataAccess",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/usesPersonalData",
              "options": {
                "widget": "radio"
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/usesThirdPartyNonPersonalData",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "NO"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/usesThirdPartyConfidentialData",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "NO"
                      }
                    },
                    {
                      "scope": "#/properties/usesThirdPartyNonPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.personalDataTypes",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/personalDataTypes",
              "options": {
                "widget": "checkbox"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/otherPersonalDataTypes",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/personalDataTypes",
                      "schema": {
                        "contains": {
                          "const": "OTHER"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.legalBasis",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/legalBasis",
              "options": {
                "widget": "checkbox"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/legalObligationReference",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": {
                        "contains": {
                          "const": "LEGAL_OBLIGATION"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.gdprComplianceDeclaration",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/declarationConfirmGDPR",
              "options": {
                "widget": "switch"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Group",
      "i18n": "groups.riskAnalysis",
      "elements": [
        {
          "type": "Group",
          "i18n": "groups.publicInterestReasons",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/legalBasisPublicInterest",
              "options": {
                "widget": "radio",
                "hideOptions": {
                  "PUBLIC_INTEREST_TASK": {
                    "scope": "#/properties/personalDataTypes",
                    "schema": {
                      "contains": {
                        "const": "GDPR_ART_9"
                      }
                    }
                  }
                }
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": {
                        "contains": {
                          "const": "PUBLIC_INTEREST"
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/ruleOfLawText",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasisPublicInterest",
                      "schema": {
                        "const": "RULE_OF_LAW"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": {
                        "contains": {
                          "const": "PUBLIC_INTEREST"
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/administrativeActText",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasisPublicInterest",
                      "schema": {
                        "const": "ADMINISTRATIVE_ACT"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": {
                        "contains": {
                          "const": "PUBLIC_INTEREST"
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/publicInterestTaskText",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasisPublicInterest",
                      "schema": {
                        "const": "PUBLIC_INTEREST_TASK"
                      }
                    },
                    {
                      "scope": "#/properties/legalBasis",
                      "schema": {
                        "contains": {
                          "const": "PUBLIC_INTEREST"
                        }
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.amountOfPersonalData",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/knowsDataQuantity",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/dataQuantity",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/knowsDataQuantity",
                      "schema": {
                        "const": "YES"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.deliveryMethod",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/deliveryMethod",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.privacyNotice",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/policyProvided",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/reasonPolicyNotProvided",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/policyProvided",
                      "schema": {
                        "const": "NO"
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/policyProvidedMedium",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/policyProvided",
                      "schema": {
                        "const": "YES"
                      }
                    }
                  ]
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/policyProvidedOnlineLink",
              "options": {
                "widget": "text"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/policyProvided",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/policyProvidedMedium",
                      "schema": {
                        "const": "ONLINE"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.integrityAndConfidentiality",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
              "options": {
                "widget": "switch"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.personalDataProtectionMeasures",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/dataProtectionMeasures",
              "options": {
                "widget": "textarea"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/personalDataTypes",
                      "schema": {
                        "contains": {
                          "const": "GDPR_ART_10"
                        }
                      }
                    },
                    {
                      "scope": "#/properties/confirmPrincipleIntegrityAndDiscretion",
                      "schema": {
                        "const": "true"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.dpia",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/doneDpia",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/doneDpaPriorConsultation",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/doneDpia",
                      "schema": {
                        "const": "YES"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.dataDownload",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/dataDownload",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/dataRetentionPeriod",
              "options": {
                "widget": "text"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/dataDownload",
                      "schema": {
                        "const": "YES"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.dataMinimization",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/purposePursuit",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/usesPersonalData",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.catalogueCheck",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/checkedExistenceMereCorrectnessInteropCatalogue",
              "options": {
                "widget": "switch"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/purposePursuit",
                      "schema": {
                        "const": "MERE_CORRECTNESS"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.neededDataCheck",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/checkedAllDataNeeded",
              "options": {
                "widget": "switch"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "type": "AND",
                  "conditions": [
                    {
                      "scope": "#/properties/usesPersonalData",
                      "schema": {
                        "const": "YES"
                      }
                    },
                    {
                      "scope": "#/properties/purposePursuit",
                      "schema": {
                        "const": "NEW_PERSONAL_DATA"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Group",
          "i18n": "groups.thirdPartyData",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/isRequestOnBehalfOfThirdParties",
              "options": {
                "widget": "radio"
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/thirdPartiesRequestDataUsage",
              "options": {
                "widget": "radio"
              },
              "rule": {
                "effect": "SHOW",
                "condition": {
                  "scope": "#/properties/isRequestOnBehalfOfThirdParties",
                  "schema": {
                    "const": "YES"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
