{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "enum": ["INSTITUTIONAL", "OTHER"],
      "default": "INSTITUTIONAL"
    },
    "purposeDescription": {
      "type": "string",
      "maxLength": 2000
    },
    "usesThirdPartyPersonalData": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "personalDataTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "WITH_NON_IDENTIFYING_DATA",
          "WITH_IDENTIFYING_DATA",
          "GDPR_ART_8",
          "GDPR_ART_9",
          "GDPR_ART_10",
          "OTHER"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "otherPersonalDataTypes": {
      "type": "string",
      "maxLength": 2000
    },
    "legalBasis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CONSENT",
          "CONTRACT",
          "LEGAL_OBLIGATION",
          "SAFEGUARD",
          "PUBLIC_INTEREST"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "legalObligationReference": {
      "type": "string",
      "maxLength": 2000
    },
    "publicInterestReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["RULE_OF_LAW", "ADMINISTRATIVE_ACT", "PUBLIC_INTEREST_TASK"]
      },
      "uniqueItems": true,
      "default": []
    },
    "legalBasisPublicInterest": {
      "type": "string",
      "enum": ["RULE_OF_LAW", "ADMINISTRATIVE_ACT", "PUBLIC_INTEREST_TASK"],
      "default": "RULE_OF_LAW"
    },
    "ruleOfLawText": {
      "type": "string",
      "maxLength": 2000
    },
    "administrativeActText": {
      "type": "string",
      "maxLength": 2000
    },
    "publicInterestTaskText": {
      "type": "string",
      "maxLength": 2000
    },
    "knowsDataQuantity": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "dataQuantity": {
      "type": "string",
      "enum": [
        "QUANTITY_0_TO_100",
        "QUANTITY_101_TO_500",
        "QUANTITY_500_TO_1000",
        "QUANTITY_1001_TO_5000",
        "QUANTITY_5001_OVER"
      ],
      "default": "QUANTITY_0_TO_100"
    },
    "deliveryMethod": {
      "type": "string",
      "enum": ["CLEARTEXT", "PSEUDOANONYMOUS", "AGGREGATE", "ANONYMOUS"],
      "default": "CLEARTEXT"
    },
    "policyProvided": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "YES"
    },
    "reasonPolicyNotProvided": {
      "type": "string",
      "maxLength": 2000
    },
    "policyProvidedMedium": {
      "type": "string",
      "enum": ["PRINT", "ONLINE"],
      "default": "PRINT"
    },
    "policyProvidedOnlineLink": {
      "type": "string",
      "maxLength": 2000
    },
    "confirmPrincipleIntegrityAndDiscretion": {
      "type": "string",
      "const": "true"
    },
    "dataProtectionMeasures": {
      "type": "string",
      "maxLength": 2000
    },
    "doneDpia": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "confirmedDoneDpia": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "dataDownload": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "dataRetentionPeriod": {
      "type": "string",
      "maxLength": 2000
    },
    "purposePursuit": {
      "type": "string",
      "enum": ["MERE_CORRECTNESS", "NEW_PERSONAL_DATA"]
    },
    "checkedExistenceMereCorrectnessInteropCatalogue": {
      "type": "string",
      "const": "true"
    },
    "checkedAllDataNeeded": {
      "type": "string",
      "const": "true"
    },
    "thirdPartiesRequestDataUsage": {
      "type": "string",
      "enum": ["PA_ONLY", "PA_ALSO"]
    },
    "declarationConfirmGDPR": {
      "type": "string",
      "const": "true"
    }
  },
  "required": [
    "purpose",
    "purposeDescription",
    "personalDataTypes",
    "legalBasis",
    "usesThirdPartyPersonalData",
    "confirmPrincipleIntegrityAndDiscretion",
    "declarationConfirmGDPR"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "personalDataTypes": {
            "type": "array",
            "contains": {
              "const": "OTHER"
            }
          }
        }
      },
      "then": {
        "required": ["otherPersonalDataTypes"]
      }
    },
    {
      "if": {
        "properties": {
          "legalBasis": {
            "type": "array",
            "contains": {
              "const": "LEGAL_OBLIGATION"
            }
          }
        }
      },
      "then": {
        "required": ["legalObligationReference"]
      }
    },
    {
      "if": {
        "properties": {
          "legalBasis": {
            "type": "array",
            "contains": {
              "const": "PUBLIC_INTEREST"
            }
          }
        }
      },
      "then": {
        "required": ["publicInterestReasons", "legalBasisPublicInterest"]
      }
    },
    {
      "if": {
        "properties": {
          "legalBasisPublicInterest": {
            "const": "RULE_OF_LAW"
          },
          "legalBasis": {
            "type": "array",
            "contains": {
              "const": "PUBLIC_INTEREST"
            }
          }
        },
        "required": ["legalBasisPublicInterest"]
      },
      "then": {
        "required": ["ruleOfLawText"]
      }
    },
    {
      "if": {
        "properties": {
          "legalBasisPublicInterest": {
            "const": "ADMINISTRATIVE_ACT"
          },
          "legalBasis": {
            "type": "array",
            "contains": {
              "const": "PUBLIC_INTEREST"
            }
          }
        },
        "required": ["legalBasisPublicInterest"]
      },
      "then": {
        "required": ["administrativeActText"]
      }
    },
    {
      "if": {
        "properties": {
          "legalBasisPublicInterest": {
            "const": "PUBLIC_INTEREST_TASK"
          }
        },
        "required": ["legalBasisPublicInterest"]
      },
      "then": {
        "required": ["publicInterestTaskText"]
      }
    },
    {
      "if": {
        "properties": {
          "knowsDataQuantity": {
            "const": "YES"
          }
        },
        "required": ["knowsDataQuantity"]
      },
      "then": {
        "required": ["dataQuantity"]
      }
    },
    {
      "if": {
        "properties": {
          "policyProvided": {
            "const": "NO"
          }
        },
        "required": ["policyProvided"]
      },
      "then": {
        "required": ["reasonPolicyNotProvided"]
      }
    },
    {
      "if": {
        "properties": {
          "policyProvided": {
            "const": "YES"
          }
        },
        "required": ["policyProvided"]
      },
      "then": {
        "required": ["policyProvidedMedium"]
      }
    },
    {
      "if": {
        "properties": {
          "policyProvided": {
            "const": "YES"
          },
          "policyProvidedMedium": {
            "const": "ONLINE"
          }
        },
        "required": ["policyProvided", "policyProvidedMedium"]
      },
      "then": {
        "required": ["policyProvidedOnlineLink"]
      }
    },
    {
      "if": {
        "properties": {
          "personalDataTypes": {
            "type": "array",
            "contains": {
              "const": "GDPR_ART_10"
            }
          },
          "confirmPrincipleIntegrityAndDiscretion": {
            "const": "true"
          }
        },
        "required": ["confirmPrincipleIntegrityAndDiscretion"]
      },
      "then": {
        "required": ["dataProtectionMeasures"]
      }
    },
    {
      "if": {
        "properties": {
          "doneDpia": {
            "const": "YES"
          }
        },
        "required": ["doneDpia"]
      },
      "then": {
        "required": ["confirmedDoneDpia"]
      }
    },
    {
      "if": {
        "properties": {
          "dataDownload": {
            "const": "YES"
          }
        },
        "required": ["dataDownload"]
      },
      "then": {
        "required": ["dataRetentionPeriod"]
      }
    },
    {
      "if": {
        "properties": {
          "purposePursuit": {
            "const": "MERE_CORRECTNESS"
          }
        },
        "required": ["purposePursuit"]
      },
      "then": {
        "required": ["checkedExistenceMereCorrectnessInteropCatalogue"]
      }
    },
    {
      "if": {
        "properties": {
          "purposePursuit": {
            "const": "NEW_PERSONAL_DATA"
          }
        },
        "required": ["purposePursuit"]
      },
      "then": {
        "required": ["checkedAllDataNeeded"]
      }
    },
    {
      "if": {
        "properties": {
          "usesThirdPartyPersonalData": {
            "const": "YES"
          }
        },
        "required": ["usesThirdPartyPersonalData"]
      },
      "then": {
        "required": ["thirdPartiesRequestDataUsage"]
      }
    }
  ]
}
