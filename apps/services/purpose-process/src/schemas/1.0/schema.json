{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "purpose": {
      "type": "string",
      "enum": ["INSTITUTIONAL", "OTHER"],
      "default": "INSTITUTIONAL"
    },
    "institutionalPurpose": {
      "type": "string",
      "maxLength": 2000
    },
    "otherPurpose": {
      "type": "string",
      "maxLength": 2000
    },
    "usesPersonalData": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "usesThirdPartyNonPersonalData": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "usesThirdPartyConfidentialData": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "personalDataTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "WITH_NON_IDENTIFYING_DATA",
          "WITH_IDENTIFYING_DATA",
          "GDPR_ART_8",
          "GDPR_ART_9",
          "GDPR_ART_10",
          "OTHER"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "otherPersonalDataTypes": {
      "type": "string",
      "maxLength": 2000
    },
    "legalBasis": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CONSENT",
          "CONTRACT",
          "LEGAL_OBLIGATION",
          "SAFEGUARD",
          "PUBLIC_INTEREST"
        ]
      },
      "uniqueItems": true,
      "default": []
    },
    "legalObligationReference": {
      "type": "string",
      "maxLength": 2000
    },
    "declarationConfirmGDPR": {
      "type": "string",
      "const": "true"
    },
    "legalBasisPublicInterest": {
      "type": "string",
      "enum": ["RULE_OF_LAW", "ADMINISTRATIVE_ACT", "PUBLIC_INTEREST_TASK"],
      "default": "RULE_OF_LAW"
    },
    "ruleOfLawText": {
      "type": "string",
      "maxLength": 2000
    },
    "administrativeActText": {
      "type": "string",
      "maxLength": 2000
    },
    "publicInterestTaskText": {
      "type": "string",
      "maxLength": 2000
    },
    "knowsDataQuantity": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "dataQuantity": {
      "type": "string",
      "enum": [
        "QUANTITY_0_TO_100",
        "QUANTITY_101_TO_500",
        "QUANTITY_500_TO_1000",
        "QUANTITY_1001_TO_5000",
        "QUANTITY_5001_OVER"
      ],
      "default": "QUANTITY_0_TO_100"
    },
    "deliveryMethod": {
      "type": "string",
      "enum": ["CLEARTEXT", "PSEUDOANONYMOUS", "AGGREGATE", "ANONYMOUS"],
      "default": "ANONYMOUS"
    },
    "policyProvided": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "YES"
    },
    "reasonPolicyNotProvided": {
      "type": "string",
      "maxLength": 2000
    },
    "policyProvidedMedium": {
      "type": "string",
      "enum": ["PRINT", "ONLINE"],
      "default": "PRINT"
    },
    "policyProvidedOnlineLink": {
      "type": "string",
      "maxLength": 2000
    },
    "confirmPrincipleIntegrityAndDiscretion": {
      "type": "string",
      "const": "true"
    },
    "dataProtectionMeasures": {
      "type": "string",
      "maxLength": 2000
    },
    "doneDpia": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "confirmedDoneDpia": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "dataDownload": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "dataRetentionPeriod": {
      "type": "string",
      "maxLength": 2000
    },
    "purposePursuit": {
      "type": "string",
      "enum": ["MERE_CORRECTNESS", "NEW_PERSONAL_DATA"],
      "default": "MERE_CORRECTNESS"
    },
    "checkedExistenceMereCorrectnessInteropCatalogue": {
      "type": "string",
      "const": "true"
    },
    "checkedAllDataNeeded": {
      "type": "string",
      "const": "true"
    },
    "isRequestOnBehalfOfThirdParties": {
      "type": "string",
      "enum": ["YES", "NO"],
      "default": "NO"
    },
    "thirdPartiesRequestDataUsage": {
      "type": "string",
      "enum": ["PA_ONLY", "PA_ALSO"]
    }
  },
  "required": ["purpose", "usesPersonalData", "isRequestOnBehalfOfThirdParties"],
  "allOf": [
    {
      "if": {
        "properties": { "purpose": { "const": "INSTITUTIONAL" } },
        "required": ["purpose"]
      },
      "then": {
        "required": ["institutionalPurpose"]
      },
      "else": {
        "properties": { "institutionalPurpose": false }
      }
    },
    {
      "if": {
        "properties": { "purpose": { "const": "OTHER" } },
        "required": ["purpose"]
      },
      "then": {
        "required": ["otherPurpose"]
      },
      "else": {
        "properties": { "otherPurpose": false }
      }
    },
    {
      "if": {
        "properties": { "usesPersonalData": { "const": "NO" } },
        "required": ["usesPersonalData"]
      },
      "then": {
        "required": ["usesThirdPartyNonPersonalData"]
      },
      "else": {
        "properties": { "usesThirdPartyNonPersonalData": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "NO" },
          "usesThirdPartyNonPersonalData": { "const": "YES" }
        },
        "required": ["usesPersonalData", "usesThirdPartyNonPersonalData"]
      },
      "then": {
        "required": ["usesThirdPartyConfidentialData"]
      },
      "else": {
        "properties": { "usesThirdPartyConfidentialData": false }
      }
    },
    {
      "if": {
        "properties": { "usesPersonalData": { "const": "YES" } },
        "required": ["usesPersonalData"]
      },
      "then": {
        "required": [
          "personalDataTypes",
          "legalBasis",
          "declarationConfirmGDPR",
          "knowsDataQuantity",
          "deliveryMethod",
          "policyProvided",
          "confirmPrincipleIntegrityAndDiscretion",
          "doneDpia",
          "dataDownload",
          "purposePursuit"
        ]
      },
      "else": {
        "properties": {
          "personalDataTypes": false,
          "legalBasis": false,
          "declarationConfirmGDPR": false,
          "knowsDataQuantity": false,
          "deliveryMethod": false,
          "policyProvided": false,
          "confirmPrincipleIntegrityAndDiscretion": false,
          "doneDpia": false,
          "dataDownload": false,
          "purposePursuit": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "personalDataTypes": {
            "type": "array",
            "contains": { "const": "OTHER" }
          }
        },
        "required": ["usesPersonalData", "personalDataTypes"]
      },
      "then": {
        "required": ["otherPersonalDataTypes"]
      },
      "else": {
        "properties": { "otherPersonalDataTypes": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "legalBasis": {
            "type": "array",
            "contains": { "const": "LEGAL_OBLIGATION" }
          }
        },
        "required": ["usesPersonalData", "legalBasis"]
      },
      "then": {
        "required": ["legalObligationReference"]
      },
      "else": {
        "properties": { "legalObligationReference": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "legalBasis": {
            "type": "array",
            "contains": { "const": "PUBLIC_INTEREST" }
          }
        },
        "required": ["usesPersonalData", "legalBasis"]
      },
      "then": {
        "required": ["legalBasisPublicInterest"]
      },
      "else": {
        "properties": { "legalBasisPublicInterest": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "personalDataTypes": {
            "type": "array",
            "contains": { "const": "GDPR_ART_9" }
          },
          "legalBasis": {
            "type": "array",
            "contains": { "const": "PUBLIC_INTEREST" }
          }
        },
        "required": ["usesPersonalData", "personalDataTypes", "legalBasis"]
      },
      "then": {
        "properties": {
          "legalBasisPublicInterest": { "not": { "const": "PUBLIC_INTEREST_TASK" } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "legalBasisPublicInterest": { "const": "RULE_OF_LAW" },
          "legalBasis": {
            "type": "array",
            "contains": { "const": "PUBLIC_INTEREST" }
          }
        },
        "required": ["usesPersonalData", "legalBasisPublicInterest", "legalBasis"]
      },
      "then": {
        "required": ["ruleOfLawText"]
      },
      "else": {
        "properties": { "ruleOfLawText": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "legalBasisPublicInterest": { "const": "ADMINISTRATIVE_ACT" },
          "legalBasis": {
            "type": "array",
            "contains": { "const": "PUBLIC_INTEREST" }
          }
        },
        "required": ["usesPersonalData", "legalBasisPublicInterest", "legalBasis"]
      },
      "then": {
        "required": ["administrativeActText"]
      },
      "else": {
        "properties": { "administrativeActText": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "legalBasisPublicInterest": { "const": "PUBLIC_INTEREST_TASK" },
          "legalBasis": {
            "type": "array",
            "contains": { "const": "PUBLIC_INTEREST" }
          }
        },
        "required": ["usesPersonalData", "legalBasisPublicInterest", "legalBasis"]
      },
      "then": {
        "required": ["publicInterestTaskText"]
      },
      "else": {
        "properties": { "publicInterestTaskText": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "knowsDataQuantity": { "const": "YES" }
        },
        "required": ["usesPersonalData", "knowsDataQuantity"]
      },
      "then": {
        "required": ["dataQuantity"]
      },
      "else": {
        "properties": { "dataQuantity": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "policyProvided": { "const": "NO" }
        },
        "required": ["usesPersonalData", "policyProvided"]
      },
      "then": {
        "required": ["reasonPolicyNotProvided"]
      },
      "else": {
        "properties": { "reasonPolicyNotProvided": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "policyProvided": { "const": "YES" }
        },
        "required": ["usesPersonalData", "policyProvided"]
      },
      "then": {
        "required": ["policyProvidedMedium"]
      },
      "else": {
        "properties": { "policyProvidedMedium": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "policyProvided": { "const": "YES" },
          "policyProvidedMedium": { "const": "ONLINE" }
        },
        "required": ["usesPersonalData", "policyProvided", "policyProvidedMedium"]
      },
      "then": {
        "required": ["policyProvidedOnlineLink"]
      },
      "else": {
        "properties": { "policyProvidedOnlineLink": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "personalDataTypes": {
            "type": "array",
            "contains": { "const": "GDPR_ART_10" }
          },
          "confirmPrincipleIntegrityAndDiscretion": { "const": "true" }
        },
        "required": [
          "usesPersonalData",
          "confirmPrincipleIntegrityAndDiscretion",
          "personalDataTypes"
        ]
      },
      "then": {
        "required": ["dataProtectionMeasures"]
      },
      "else": {
        "properties": { "dataProtectionMeasures": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "doneDpia": { "const": "YES" }
        },
        "required": ["usesPersonalData", "doneDpia"]
      },
      "then": {
        "required": ["confirmedDoneDpia"]
      },
      "else": {
        "properties": { "confirmedDoneDpia": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "dataDownload": { "const": "YES" }
        },
        "required": ["usesPersonalData", "dataDownload"]
      },
      "then": {
        "required": ["dataRetentionPeriod"]
      },
      "else": {
        "properties": { "dataRetentionPeriod": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "purposePursuit": { "const": "MERE_CORRECTNESS" }
        },
        "required": ["usesPersonalData", "purposePursuit"]
      },
      "then": {
        "required": ["checkedExistenceMereCorrectnessInteropCatalogue"]
      },
      "else": {
        "properties": { "checkedExistenceMereCorrectnessInteropCatalogue": false }
      }
    },
    {
      "if": {
        "properties": {
          "usesPersonalData": { "const": "YES" },
          "purposePursuit": { "const": "NEW_PERSONAL_DATA" }
        },
        "required": ["usesPersonalData", "purposePursuit"]
      },
      "then": {
        "required": ["checkedAllDataNeeded"]
      },
      "else": {
        "properties": { "checkedAllDataNeeded": false }
      }
    },
    {
      "if": {
        "properties": {
          "isRequestOnBehalfOfThirdParties": { "const": "YES" }
        },
        "required": ["isRequestOnBehalfOfThirdParties"]
      },
      "then": {
        "required": ["thirdPartiesRequestDataUsage"]
      },
      "else": {
        "properties": { "thirdPartiesRequestDataUsage": false }
      }
    }
  ]
}
