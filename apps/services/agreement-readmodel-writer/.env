LOG_LEVEL=info

READMODEL_DB_USER=local_agreement_rmw_user
READMODEL_DB_PASSWORD=local_agreement_rmw_user
READMODEL_DB_HOST=localhost
READMODEL_DB_PORT=5432
READMODEL_DB_NAME=readmodel
READMODEL_DB_USE_SSL=false

