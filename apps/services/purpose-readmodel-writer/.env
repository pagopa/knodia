LOG_LEVEL=info

READMODEL_DB_USER=local_purpose_rmw_user
READMODEL_DB_PASSWORD=local_purpose_rmw_user
READMODEL_DB_HOST=localhost
READMODEL_DB_PORT=5432
READMODEL_DB_NAME=readmodel
READMODEL_DB_USE_SSL=false

READMODEL_DB_PURPOSE_SCHEMA=local_purpose

