LOG_LEVEL=info

HOST=0.0.0.0
PORT=4200

AWS_CONFIG_FILE=aws.config.local

ACCEPTED_AUDIENCES=local.knodia.test/ui-signup-session,local.knodia.test/internal
WELL_KNOWN_URLS=http://localhost:4500/knodia/.well-known/jwks.json

ONE_IDENTITY_CLIENT_ID=local-oi-client-id
ONE_IDENTITY_CLIENT_SECRET=local-oi-client-secret
ONE_IDENTITY_DOMAIN=http://localhost:4568
ONE_IDENTITY_JWKS_URI=http://localhost:4568/jwks
ONE_IDENTITY_REDIRECT_URL=http://localhost:5176/ui/login/callback

UI_SIGNUP_SESSION_JWT_AUDIENCE=local.knodia.test/ui-signup-session
UI_SIGNUP_SESSION_JWT_ISSUER=local-knodia
UI_SIGNUP_SESSION_JWT_KID=alias/local-knodia-key
UI_SIGNUP_SESSION_JWT_SECONDS_DURATION=300

SIGNUP_DB_HOST=localhost
SIGNUP_DB_NAME=signup
SIGNUP_DB_PASSWORD=local_signup_manager_user
SIGNUP_DB_PORT=5432
SIGNUP_DB_USE_SSL=false
SIGNUP_DB_USER=local_signup_manager_user
SIGNUP_DB_SCHEMA=local_signup

KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=kafka-signup-manager-client
KAFKA_LOG_LEVEL=INFO
KAFKA_DISABLE_AWS_IAM_AUTH=true

SIGNUP_TOPIC=signup.events

RATE_LIMITER_DISABLE_AWS_IAM_AUTH=true
RATE_LIMITER_ENVIRONMENT=local
RATE_LIMITER_MAX_REQUESTS=100
RATE_LIMITER_TIME_WINDOW_SECONDS=60
RATE_LIMITER_REDIS_HOST=localhost
RATE_LIMITER_REDIS_PORT=6379
RATE_LIMITER_TIMEOUT_SECONDS=2
