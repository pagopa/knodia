{
  "name": "@knodia/backend-for-frontend",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n tsc,run -c auto -k 'tsc --watch --pretty' 'node --watch ./src/index.ts'",
    "typecheck": "tsc",
    "generate-openapi": "node ./openapi/generateOpenapi.ts",
    "lint-openapi": "spectral lint ./openapi/openapi.yaml --ruleset=./spectral.yaml",
    "lint": "eslint .",
    "lint:autofix": "eslint . --fix"
  },
  "devDependencies": {
    "@knodia/eslint-config": "workspace:*",
    "@knodia/typescript-config": "workspace:*",
    "@knodia/spectral-config": "workspace:*",
    "@stoplight/spectral-cli": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@knodia/eservice-models": "workspace:*",
    "@knodia/fastify-plugin-openapi-zod": "workspace:*",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "zod": "catalog:"
  }
}
