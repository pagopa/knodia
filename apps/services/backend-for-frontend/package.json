{
  "name": "@knodia/backend-for-frontend",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n tsc,run -c auto -k 'tsc --watch --pretty' 'dotenvx run -- node --watch ./src/index.ts'",
    "typecheck": "tsc",
    "generate-openapi": "dotenvx run -- node ./openapi/generateOpenapi.ts",
    "lint": "eslint .",
    "lint:autofix": "eslint . --fix",
    "lint-openapi": "spectral lint --fail-severity='warn' ./openapi/openapi.yaml --ruleset=./spectral.yaml"
  },
  "devDependencies": {
    "@knodia/eslint-config": "workspace:*",
    "@knodia/spectral-config": "workspace:*",
    "@knodia/test-commons": "workspace:*",
    "@knodia/typescript-config": "workspace:*",
    "@stoplight/spectral-cli": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "catalog:",
    "@dotenvx/dotenvx": "catalog:",
    "@fastify/cookie": "catalog:",
    "@fastify/request-context": "catalog:",
    "@knodia/agreement-models": "workspace:*",
    "@knodia/agreement-process-client": "workspace:*",
    "@knodia/attribute-models": "workspace:*",
    "@knodia/common-models": "workspace:*",
    "@knodia/db-jti-replay-store": "workspace:*",
    "@knodia/eservice-models": "workspace:*",
    "@knodia/eservice-process-client": "workspace:*",
    "@knodia/fastify-zod-api-commons": "workspace:*",
    "@knodia/file-manager": "workspace:*",
    "@knodia/keychain-models": "workspace:*",
    "@knodia/keychain-process-client": "workspace:*",
    "@knodia/logger": "workspace:*",
    "@knodia/organization-models": "workspace:*",
    "@knodia/organization-process-client": "workspace:*",
    "@knodia/purpose-models": "workspace:*",
    "@knodia/purpose-process-client": "workspace:*",
    "@knodia/polling": "workspace:*",
    "@knodia/remote-resources-manager-client": "workspace:*",
    "@knodia/token-generator": "workspace:*",
    "axios": "catalog:",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "jose": "catalog:",
    "pino-pretty": "catalog:",
    "zod": "catalog:"
  }
}
