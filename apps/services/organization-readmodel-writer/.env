LOG_LEVEL=info

READMODEL_DB_USER=local_organization_rmw_user
READMODEL_DB_PASSWORD=local_organization_rmw_user
READMODEL_DB_HOST=localhost
READMODEL_DB_PORT=5432
READMODEL_DB_NAME=readmodel
READMODEL_DB_USE_SSL=false

READMODEL_DB_ORGANIZATION_SCHEMA=local_organization

KAFKA_BROKERS=localhost:29092
KAFKA_LOG_LEVEL=INFO
KAFKA_CLIENT_ID=kafka-organization-client
KAFKA_GROUP_ID=kafka-organization-readmodel-writer
TOPIC_STARTING_OFFSET=latest
KAFKA_DISABLE_AWS_IAM_AUTH=true

ORGANIZATION_TOPIC=event-store.local_organization.events

AWS_REGION=eu-south-1
