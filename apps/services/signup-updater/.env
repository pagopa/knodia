LOG_LEVEL=info

KAFKA_BROKERS=localhost:29092
KAFKA_LOG_LEVEL=INFO
KAFKA_CLIENT_ID=kafka-signup-updater-client
KAFKA_DISABLE_AWS_IAM_AUTH=true

KAFKA_GROUP_ID=kafka-signup-updater
TOPIC_STARTING_OFFSET=latest

SIGNUP_TOPIC=signup.events

AWS_CONFIG_FILE=aws.config.local

SIGNUP_DB_USER=local_signup_updater_user
SIGNUP_DB_PASSWORD=local_signup_updater_user
SIGNUP_DB_HOST=localhost
SIGNUP_DB_PORT=5432
SIGNUP_DB_NAME=signup
SIGNUP_DB_SCHEMA=local_signup
SIGNUP_DB_USE_SSL=false

ORGANIZATION_PROCESS_ORION_URL=http://localhost:3400
ORGANIZATION_PROCESS_LYNX_URL=http://localhost:3400

COGNITO_USER_POOL_ID_ORION=local-user-pool-id-for-tests
COGNITO_USER_POOL_ID_LYNX=local-user-pool-id-for-tests

INTERNAL_JWT_AUDIENCE=local.knodia.test/internal
INTERNAL_JWT_ISSUER=local-knodia
INTERNAL_JWT_KID=alias/local-knodia-key
INTERNAL_JWT_SECONDS_DURATION=3600
INTERNAL_JWT_SUBJECT=signup-updater
